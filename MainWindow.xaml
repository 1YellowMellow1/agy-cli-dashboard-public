<Window
    x:Class="AgyCliDashboard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:terminal="using:EasyWindowsTerminalControl"
    xmlns:local="using:AgyCliDashboard"
    xmlns:views="using:AgyCliDashboard.Views"
    Title="ANTIGRAVITY CLI Dashboard"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{StaticResource AgyMainBg}">
        <Grid.RowDefinitions>
            <!-- Custom Dark TitleBar Header (Height=56px) -->
            <RowDefinition Height="56" />
            <!-- Main Body (Sidebar + Content) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== HEADER USERCONTROL (56px) ==================== -->
        <views:HeaderView x:Name="UcHeader" Grid.Row="0" />

        <!-- ==================== MAIN BODY (SIDEBAR + CONTENT) ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Content Area -->
                <ColumnDefinition Width="*" />
                <!-- Sidebar (350px) -->
                <ColumnDefinition x:Name="ColSidebar" Width="350" />
            </Grid.ColumnDefinitions>

            <!-- ==================== SIDEBAR (350px) ==================== -->
            <Border Grid.Column="1" Background="{StaticResource AgySidebarBg}" BorderBrush="{StaticResource AgyBorderDefault}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Workspace Header & Project Dropdown -->
                        <RowDefinition Height="Auto" />
                        <!-- Tab Bar (Chats, Dateien, Wissen, Git) -->
                        <RowDefinition Height="Auto" />
                        <!-- Scrollable Content Area -->
                        <RowDefinition Height="*" />
                        <!-- Bottom Bar (Settings) -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <StackPanel Grid.Row="0" Padding="14" Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" VerticalAlignment="Center" ColumnSpacing="6" Margin="0,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Lucide folder -->
                                <ImageIcon Grid.Column="0" Source="ms-appx:///Assets/Icons/folder.svg" Width="16" Height="16" UseLayoutRounding="True" />
                                <TextBlock Grid.Column="1" Text="PROJEKTE" FontSize="{StaticResource AgyFontSizeBody}" FontWeight="Bold" Foreground="{StaticResource AgyTextSecondary}" CharacterSpacing="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                <Button Style="{StaticResource AgySubtleAccentButtonStyle}" Click="BtnNewChat_Click" Tag="Neuer Chat erstellen" Width="37" Height="37" ToolTipService.ToolTip="Neuer Chat (/clear)">
                                    <!-- Lucide plus -->
                                    <ImageIcon Source="ms-appx:///Assets/Icons/plus.svg" Width="18" Height="18" UseLayoutRounding="True" />
                                </Button>
                                <Button Style="{StaticResource AgyGhostButtonStyle}" Click="BtnRefreshSidebar_Click" Tag="Workspace Aktualisieren" Width="37" Height="37" BorderBrush="{StaticResource AgyBorderFaint}" ToolTipService.ToolTip="Aktualisieren">
                                    <!-- Lucide refresh-cw -->
                                    <ImageIcon Source="ms-appx:///Assets/Icons/refresh-cw.svg" Width="14" Height="14" />
                                </Button>
                                <Button x:Name="BtnChatsMore" Style="{StaticResource AgyGhostButtonStyle}" Tag="Weitere Chat-Aktionen" Width="37" Height="37" BorderBrush="{StaticResource AgyBorderFaint}" ToolTipService.ToolTip="Weitere Chat-Aktionen">
                                    <!-- Lucide ellipsis -->
                                    <ImageIcon Source="ms-appx:///Assets/Icons/more-horizontal.svg" Width="16" Height="16" />
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuFlyoutItem Text="Alle Pins lösen" Click="BtnUnpinAll_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <!-- Lucide pin-off -->
                                                    <ImageIcon Source="ms-appx:///Assets/Icons/pin-off.svg" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Chats auswählen &amp; löschen" Click="BtnDeleteAllChats_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <!-- Lucide trash-2 -->
                                                    <ImageIcon Source="ms-appx:///Assets/Icons/trash-2.svg" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Project Selector Dropdown & Settings Gear -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbProjectSelector" 
                                      Grid.Column="0" 
                                      HorizontalAlignment="Stretch" 
                                      Height="37" 
                                      Background="{StaticResource AgySurfaceBg}" 
                                      BorderBrush="{StaticResource AgyBorderStrong}" 
                                      BorderThickness="1" 
                                      CornerRadius="{StaticResource AgyRadiusMd}" 
                                      FontSize="{StaticResource AgyFontSizeTitle}" 
                                      Foreground="{StaticResource AgyTextPrimary}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" 
                                                   Foreground="{Binding TextForeground}" 
                                                   FontWeight="{Binding TextFontWeight}" 
                                                   FontSize="{StaticResource AgyFontSizeTitle}" 
                                                   VerticalAlignment="Center" 
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Style="{StaticResource AgyGhostButtonStyle}" x:Name="BtnLanguageToggle" Click="BtnLanguageToggle_Click" Grid.Column="1" Width="37" Height="37" Margin="6,0,0,0" ToolTipService.ToolTip="Sprache wechseln (DE / EN)" Visibility="Visible">
                                <TextBlock x:Name="TxtLanguageIndicator" Text="DE" FontWeight="Bold" FontSize="{StaticResource AgyFontSizeSubtitle}" Foreground="{StaticResource AgyTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button Style="{StaticResource AgyGhostButtonStyle}" Click="BtnProjectSettings_Click" Tag="Projekte Ein-/Ausblenden" Grid.Column="2" Width="37" Height="37" Margin="4,0,0,0" ToolTipService.ToolTip="Projekte ein- / ausblenden">
                                <!-- Lucide settings -->
                                <ImageIcon Source="ms-appx:///Assets/Icons/settings.svg" Width="18" Height="18" UseLayoutRounding="True" />
                            </Button>
                        </Grid>

                        <!-- INLINE PROJECT SETTINGS PANEL -->
                        <Border x:Name="PnlInlineProjectSettings" Visibility="Collapsed" Background="{StaticResource AgyCardBg}" BorderBrush="{StaticResource AgyBorderDefault}" BorderThickness="1" CornerRadius="{StaticResource AgyRadiusLg}" Padding="10" Margin="0,4,0,0">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <!-- Lucide settings -->
                                    <ImageIcon Source="ms-appx:///Assets/Icons/settings.svg" Width="14" Height="14" />
                                    <TextBlock x:Name="TxtSettingsTitle" Text="Projekteinstellungen" FontSize="{StaticResource AgyFontSizeSubtitle}" FontWeight="Bold" Foreground="{StaticResource AgyTextSecondary}" />
                                </StackPanel>
                                <TextBlock x:Name="TxtSettingsBaseFolder" Text="Master-Ordner für Projekte:" FontSize="{StaticResource AgyFontSizeBodyLarge}" Foreground="{StaticResource AgyTextMuted}" />
                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtProjectsBaseFolder" IsReadOnly="True" FontSize="{StaticResource AgyFontSizeBodyLarge}" Background="{StaticResource AgyMainBg}" Foreground="{StaticResource AgyTextPrimary}" BorderBrush="{StaticResource AgyBorderFaint}" Padding="4,2"/>
                                    <Button AllowFocusOnInteraction="False" Click="BtnBrowseBaseFolder_Click" Grid.Column="1" Content="..." FontSize="{StaticResource AgyFontSizeBodyLarge}" Padding="6,2" Background="{StaticResource AgyAccent}" Foreground="{StaticResource AgyTextPrimary}" CornerRadius="{StaticResource AgyRadiusSm}"/>
                                </Grid>
                                <Grid Margin="0,6,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtSettingsProjectsVisible" Grid.Column="0" Text="Projekte (Sichtbar):" FontSize="{StaticResource AgyFontSizeBodyLarge}" Foreground="{StaticResource AgyTextMuted}" />
                                    <TextBlock x:Name="TxtSettingsDefaultReflection" Grid.Column="1" Text="Standard-Reflexion:" FontSize="{StaticResource AgyFontSizeBodyLarge}" Foreground="{StaticResource AgyTextMuted}" />
                                </Grid>
                                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ListProjectItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="130" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible, Mode=TwoWay}" VerticalAlignment="Center" ToolTipService.ToolTip="Projekt im Dropdown-Menü anzeigen">
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource AgyTextPrimary}" FontSize="{StaticResource AgyFontSizeSubtitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    </CheckBox>
                                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsAutoReflexionEnabled, Mode=TwoWay}" VerticalAlignment="Center" ToolTipService.ToolTip="Auto-Reflexion für dieses Projekt standardmäßig aktivieren">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <ImageIcon Source="ms-appx:///Assets/Icons/shield-check.svg" Width="13" Height="13" VerticalAlignment="Center" />
                                                            <TextBlock Text="Aktiv" Foreground="{StaticResource AgyTextSecondary}" FontSize="{StaticResource AgyFontSizeCaption}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Border Height="1" Background="{StaticResource AgyBorderFaint}" Margin="0,4,0,2" />
                                <CheckBox x:Name="ChkRestoreSessions"
                                          Click="ChkRestoreSessions_Click"
                                          IsChecked="True"
                                          VerticalAlignment="Center"
                                          ToolTipService.ToolTip="Stellt beim nächsten Dashboard-Start automatisch alle zuvor geöffneten Chats wieder her.">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <!-- Lucide history -->
                                        <ImageIcon Source="ms-appx:///Assets/Icons/history.svg" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtSettingsRestoreSessions" Text="Offene Chats bei Neustart wiederherstellen" Foreground="{StaticResource AgyTextPrimary}" FontSize="{StaticResource AgyFontSizeSubtitle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </CheckBox>
                                <Grid x:Name="PnlLanguageSetting" Margin="0,4,0,2" Visibility="Visible">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtSettingsLanguage" Text="Sprache / Language:" FontSize="{StaticResource AgyFontSizeBodyLarge}" Foreground="{StaticResource AgyTextMuted}" VerticalAlignment="Center" />
                                    <ComboBox x:Name="CmbLanguage" Grid.Column="1" SelectionChanged="CmbLanguage_SelectionChanged" Height="30" FontSize="{StaticResource AgyFontSizeSubtitle}" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Automatisch" Tag="auto" />
                                        <ComboBoxItem Content="Deutsch (DE)" Tag="de" />
                                        <ComboBoxItem Content="English (EN)" Tag="en" />
                                    </ComboBox>
                                </Grid>
                                <Button x:Name="BtnCloseInlineSettings" AllowFocusOnInteraction="False" Click="BtnCloseInlineSettings_Click" Content="Fertig" HorizontalAlignment="Right" FontSize="{StaticResource AgyFontSizeBodyLarge}" Padding="10,4" Background="{StaticResource AgyAccent}" Foreground="{StaticResource AgyTextPrimary}" CornerRadius="{StaticResource AgyRadiusSm}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Active Project Git Info & Push Button -->
                        <Border Background="{StaticResource AgySurfaceBg}" BorderBrush="{StaticResource AgyBorderDefault}" BorderThickness="1" CornerRadius="{StaticResource AgyRadiusXl}" Padding="10">
                            <StackPanel Spacing="6">
                                <Grid>
                                    <Button AllowFocusOnInteraction="False" Click="BtnProjectHeaderLink_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTipService.ToolTip="Repository im Browser öffnen (oder Remote verknüpfen)">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <!-- GitHub Logo -->
                                            <ImageIcon Source="ms-appx:///Assets/Icons/github.svg" Width="13" Height="13" />
                                            <TextBlock x:Name="TxtActiveProject" Text="agy-cli-dashboard" FontSize="{StaticResource AgyFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{StaticResource AgyTextSecondary}" />
                                            <Ellipse x:Name="DotGitRemote" Width="6" Height="6" Fill="{StaticResource AgyStatusSuccess}" VerticalAlignment="Center" ToolTipService.ToolTip="Git Remote Status" />
                                        </StackPanel>
                                    </Button>
                                    <Button AllowFocusOnInteraction="False" Click="BtnEditRemote_Click" Tag="Repository Link Bearbeiten" HorizontalAlignment="Right" Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Repository-Link hinzufügen / bearbeiten">
                                        <!-- Lucide edit-3 -->
                                        <ImageIcon Source="ms-appx:///Assets/Icons/edit-3.svg" Width="12" Height="12" />
                                    </Button>
                                </Grid>

                                <Grid>
                                    <TextBlock x:Name="TxtActiveProjectLastUpdate" Text="Update: --" FontSize="{StaticResource AgyFontSizeMicro}" Foreground="{StaticResource AgyTextSubtle}" FontFamily="Consolas" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource AgySurfaceButtonStyle}" x:Name="BtnAutoPush" Click="BtnAutoPush_Click" Tag="Auto Push" Height="24" Padding="6,0" CornerRadius="{StaticResource AgyRadiusSm}" ToolTipService.ToolTip="Auto-Backup: Erstellt alle 30 Min. automatisch einen Git-Commit und pusht zu Remote">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Ellipse x:Name="DotAutoPush" Width="5" Height="5" Fill="{StaticResource AgyStatusSuccess}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TxtAutoPush" Text="Auto" FontSize="{StaticResource AgyFontSizeCaption}" FontWeight="SemiBold" Foreground="{StaticResource AgyStatusSuccess}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource AgySubtleAccentButtonStyle}" x:Name="BtnGitPush" Click="BtnGitPush_Click" Tag="Git Push ausführen" Height="24" Padding="8,0" CornerRadius="{StaticResource AgyRadiusSm}" ToolTipService.ToolTip="Projekt online pushen (git push) - Rechtsklick für Optionen">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <!-- Lucide upload-cloud -->
                                                <ImageIcon Source="ms-appx:///Assets/Icons/upload-cloud.svg" Width="11" Height="11" />
                                                <TextBlock Text="Push" FontSize="{StaticResource AgyFontSizeCaption}" FontWeight="SemiBold" Foreground="{StaticResource AgyAccentLight}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- INLINE GIT REMOTE EDIT PANEL -->
                                <Border x:Name="PnlInlineGitRemote" Visibility="Collapsed" Background="{StaticResource AgySurfaceBg}" BorderBrush="{StaticResource AgyBorderDefault}" BorderThickness="1" CornerRadius="{StaticResource AgyRadiusLg}" Padding="10" Margin="0,4,0,0">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <!-- Lucide github -->
                                            <ImageIcon Source="ms-appx:///Assets/Icons/github.svg" Width="12" Height="12" />
                                            <TextBlock Text="Git Remote URL (Repository-Link):" FontSize="{StaticResource AgyFontSizeBodyLarge}" FontWeight="SemiBold" Foreground="{StaticResource AgyTextSecondary}" />
                                        </StackPanel>
                                        <TextBox x:Name="TxtGitRemoteUrlInput" PlaceholderText="https://github.com/benutzer/repository.git" FontSize="{StaticResource AgyFontSizeSubtitle}" Background="{StaticResource AgyMainBg}" Foreground="{StaticResource AgyTextPrimary}" BorderBrush="{StaticResource AgyBorderDefault}" CornerRadius="{StaticResource AgyRadiusSm}" Padding="6,4" KeyDown="TxtGitRemoteUrlInput_KeyDown"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                            <Button AllowFocusOnInteraction="False" Click="BtnCancelGitRemote_Click" Content="Abbrechen" FontSize="{StaticResource AgyFontSizeBodyLarge}" Padding="8,3" Background="Transparent" Foreground="{StaticResource AgyTextMuted}" CornerRadius="{StaticResource AgyRadiusSm}"/>
                                            <Button AllowFocusOnInteraction="False" Click="BtnSaveGitRemote_Click" Content="Speichern &amp; Verknüpfen" FontSize="{StaticResource AgyFontSizeBodyLarge}" Padding="10,3" Background="{StaticResource AgyAccent}" Foreground="{StaticResource AgyTextPrimary}" CornerRadius="{StaticResource AgyRadiusSm}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Sidebar Tabs Bar (Chats, Prompts, Dateien, Wissen, Git) -->
                    <Border Grid.Row="1" Background="{StaticResource AgySurfaceBg}" BorderBrush="{StaticResource AgyBorderDefault}" BorderThickness="0,1,0,1" Padding="8,5">
                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Chats Tab -->
                            <Button Grid.Column="0" HorizontalAlignment="Stretch" AllowFocusOnInteraction="False" x:Name="TabChatsBtn" Click="TabNav_Click" PointerEntered="TabNav_PointerEntered" PointerExited="TabNav_PointerExited" Tag="chats" Height="32" Padding="0" Background="{StaticResource AgyAccentSubtle}" BorderThickness="0" CornerRadius="{StaticResource AgyRadiusMd}" Style="{StaticResource AgyTabButtonStyle}" ToolTipService.ToolTip="Chats &amp; Sessions (Strg+1 · Neuer Chat, Verlauf &amp; Subagenten)">
                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <ImageIcon Source="ms-appx:///Assets/Icons/message-square.svg" Width="16" Height="16" UseLayoutRounding="True" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
                                    <Border x:Name="TabChatsIndicator" Height="2.5" Background="{StaticResource AgyAccentLight}" CornerRadius="1.25" VerticalAlignment="Bottom" Margin="6,0,6,1" Visibility="Visible" />
                                </Grid>
                            </Button>

                            <!-- Prompts Tab -->
                            <Button Grid.Column="1" HorizontalAlignment="Stretch" AllowFocusOnInteraction="False" x:Name="TabPromptsBtn" Click="TabNav_Click" PointerEntered="TabNav_PointerEntered" PointerExited="TabNav_PointerExited" Tag="prompts" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="{StaticResource AgyRadiusMd}" Style="{StaticResource AgyTabButtonStyle}" ToolTipService.ToolTip="Prompt-Vorlagen (Strg+2 · Schnelle Befehle &amp; Automationen)">
                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <ImageIcon Source="ms-appx:///Assets/Icons/zap.svg" Width="16" Height="16" UseLayoutRounding="True" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
                                    <Border x:Name="TabPromptsIndicator" Height="2.5" Background="{StaticResource AgyAccentLight}" CornerRadius="1.25" VerticalAlignment="Bottom" Margin="6,0,6,1" Visibility="Collapsed" />
                                </Grid>
                            </Button>

                            <!-- Dateien Tab -->
                            <Button Grid.Column="2" HorizontalAlignment="Stretch" AllowFocusOnInteraction="False" x:Name="TabFilesBtn" Click="TabNav_Click" PointerEntered="TabNav_PointerEntered" PointerExited="TabNav_PointerExited" Tag="files" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="{StaticResource AgyRadiusMd}" Style="{StaticResource AgyTabButtonStyle}" ToolTipService.ToolTip="Projekt-Dateien &amp; Kontext (Strg+3 · Dateien durchsuchen &amp; einbinden)">
                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <ImageIcon Source="ms-appx:///Assets/Icons/folder.svg" Width="16" Height="16" UseLayoutRounding="True" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
                                    <Border x:Name="TabFilesIndicator" Height="2.5" Background="{StaticResource AgyAccentLight}" CornerRadius="1.25" VerticalAlignment="Bottom" Margin="6,0,6,1" Visibility="Collapsed" />
                                </Grid>
                            </Button>

                            <!-- Wissen Tab -->
                            <Button Grid.Column="3" HorizontalAlignment="Stretch" AllowFocusOnInteraction="False" x:Name="TabDocsBtn" Click="TabNav_Click" PointerEntered="TabNav_PointerEntered" PointerExited="TabNav_PointerExited" Tag="docs" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="{StaticResource AgyRadiusMd}" Style="{StaticResource AgyTabButtonStyle}" ToolTipService.ToolTip="Projekt-Wissen &amp; MCP (Strg+4 · Regeln, Skills &amp; Docs)">
                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <ImageIcon Source="ms-appx:///Assets/Icons/book-open.svg" Width="16" Height="16" UseLayoutRounding="True" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
                                    <Border x:Name="TabDocsIndicator" Height="2.5" Background="{StaticResource AgyAccentLight}" CornerRadius="1.25" VerticalAlignment="Bottom" Margin="6,0,6,1" Visibility="Collapsed" />
                                </Grid>
                            </Button>

                            <!-- Git Tab -->
                            <Button Grid.Column="4" HorizontalAlignment="Stretch" AllowFocusOnInteraction="False" x:Name="TabGitBtn" Click="TabNav_Click" PointerEntered="TabNav_PointerEntered" PointerExited="TabNav_PointerExited" Tag="git" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="{StaticResource AgyRadiusMd}" Style="{StaticResource AgyTabButtonStyle}" ToolTipService.ToolTip="Git-Repository &amp; Commits (Strg+5 · Diff-Viewer &amp; History)">
                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <ImageIcon Source="ms-appx:///Assets/Icons/git-branch.svg" Width="16" Height="16" UseLayoutRounding="True" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
                                    <Border x:Name="TabGitIndicator" Height="2.5" Background="{StaticResource AgyAccentLight}" CornerRadius="1.25" VerticalAlignment="Bottom" Margin="6,0,6,1" Visibility="Collapsed" />
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Sidebar Content Host (Bounded Height for Virtualization) -->
                    <Grid Grid.Row="2" Padding="12">
                        <!-- CHATS TAB USERCONTROL -->
                        <views:ChatSidebarView x:Name="UcChatSidebar"
                                               Chats="{x:Bind _chats, Mode=OneWay}" />

                        <!-- PROMPTS TAB USERCONTROL -->
                        <views:PromptsSidebarView x:Name="UcPromptsSidebar" Visibility="Collapsed" />

                        <!-- FILES TAB USERCONTROL -->
                        <views:FilesSidebarView x:Name="UcFilesSidebar" Visibility="Collapsed" />

                        <!-- DOCS & TEXT INJECTIONS TAB USERCONTROL -->
                        <views:DocsSidebarView x:Name="UcDocsSidebar" Visibility="Collapsed" />

                        <!-- GIT TAB USERCONTROL -->
                        <views:GitSidebarView x:Name="UcGitSidebar" Visibility="Collapsed" />
                    </Grid>

                    <!-- ==================== MODEL PICKER PANEL USERCONTROL ==================== -->
                    <views:ModelPickerView x:Name="UcModelPicker" Grid.Row="0" Grid.RowSpan="4" Visibility="Collapsed" />

                    <!-- ==================== TERMINAL SHORTCUTS CATALOG USERCONTROL ==================== -->
                    <views:TerminalShortcutsView x:Name="UcTerminalShortcuts" Grid.Row="0" Grid.RowSpan="4" Visibility="Collapsed" />

                    <!-- ==================== STANDALONE SYSTEM CHECK PANEL ==================== -->
                    <Grid x:Name="PnlSystemCheckPanel" Grid.Row="0" Grid.RowSpan="4" Visibility="Collapsed" Background="{StaticResource AgySidebarBg}">
                        <Grid.RowDefinitions>
                            <!-- Header Bar -->
                            <RowDefinition Height="Auto" />
                            <!-- Requirements List -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header Bar with Back Button & Refresh -->
                        <Border Grid.Row="0" Background="{StaticResource AgyHeaderBg}" BorderBrush="{StaticResource AgyBorderDefault}" BorderThickness="0,0,0,1" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Back Button -->
                                <Button Style="{StaticResource AgySubtleAccentButtonStyle}" Click="BtnCloseSystemCheckPanel_Click" Height="30" Padding="8,0" ToolTipService.ToolTip="Zurück zur Sidebar">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="← Zurück" FontSize="{StaticResource AgyFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{StaticResource AgyTextPrimary}" />
                                    </StackPanel>
                                </Button>

                                <!-- Panel Title -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ImageIcon Source="ms-appx:///Assets/Icons/shield-check.svg" Width="16" Height="16" UseLayoutRounding="True" />
                                    <TextBlock Text="SYSTEM VORAUSSETZUNGEN" FontSize="{StaticResource AgyFontSizeSubtitle}" FontWeight="Bold" Foreground="{StaticResource AgyTextSecondary}" CharacterSpacing="20" />
                                </StackPanel>

                                <!-- Refresh Button -->
                                <Button Style="{StaticResource AgySubtleAccentButtonStyle}" x:Name="BtnRefreshSystemCheck" Grid.Column="2" Click="BtnRefreshSystemCheck_Click" Width="30" Height="30" ToolTipService.ToolTip="Prüfung erneut ausführen">
                                    <ImageIcon Source="ms-appx:///Assets/Icons/refresh-cw.svg" Width="12" Height="12" UseLayoutRounding="True" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Scrollable Requirements List -->
                        <ScrollViewer Grid.Row="1" Padding="14,14,14,64">
                            <StackPanel x:Name="PnlSystemCheckList" Spacing="8">
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ==================== CUSTOM PROMPT PANEL (LIST & EDITOR) ==================== -->
                    <Grid x:Name="PnlCustomPromptEditor" Grid.Row="0" Grid.RowSpan="4" Visibility="Collapsed" Background="{StaticResource AgySidebarBg}">
                        <Grid.RowDefinitions>
                            <!-- Header Bar -->
                            <RowDefinition Height="Auto" />
                            <!-- Content Area -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header Bar with Back Button -->
                        <Border Grid.Row="0" Background="{StaticResource AgyHeaderBg}" BorderBrush="{StaticResource AgyBorderDefault}" BorderThickness="0,0,0,1" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Navigation & Actions (Back + New Chat) -->
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Style="{StaticResource AgySubtleAccentButtonStyle}" x:Name="BtnCloseCustomPromptPanel" Click="BtnCloseCustomPromptPanel_Click" Height="30" Padding="8,0" ToolTipService.ToolTip="Zurück zur Sidebar">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="← Zurück" FontSize="{StaticResource AgyFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{StaticResource AgyTextPrimary}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource AgySubtleAccentButtonStyle}" x:Name="BtnCustomPromptNewChat" Click="BtnNewChat_Click" Width="30" Height="30" ToolTipService.ToolTip="Neuer Chat (/clear)">
                                        <ImageIcon Source="ms-appx:///Assets/Icons/plus.svg" Width="14" Height="14" UseLayoutRounding="True" />
                                    </Button>
                                </StackPanel>

                                <!-- Panel Title, Project Badge & Info -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource AgyGhostButtonStyle}" Width="20" Height="20" CornerRadius="10" ToolTipService.ToolTip="Bedienung:&#x0a;• Linksklick auf Karte: Prompt direkt ausführen oder an Chattext anhängen&#x0a;• Stift-Icon: Button bearbeiten&#x0a;• Papierkorb-Icon: Button löschen&#x0a;• Toolbar-Stern: Führt immer den 1. Prompt aus">
                                        <TextBlock Text="?" FontSize="{StaticResource AgyFontSizeMicro}" FontWeight="SemiBold" Foreground="{StaticResource AgyTextMuted}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Button>
                                    <TextBlock x:Name="TxtCustomPromptPanelTitle" Text="CUSTOM PROMPTS" FontSize="{StaticResource AgyFontSizeBodyLarge}" FontWeight="Bold" Foreground="{StaticResource AgyTextSecondary}" CharacterSpacing="15" VerticalAlignment="Center" />
                                    <Border Background="{StaticResource AgyAccentSubtle}" BorderBrush="{StaticResource AgyBorderDefault}" BorderThickness="1" CornerRadius="{StaticResource AgyRadiusSm}" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtCustomPromptProjectBadge" Text="Projekt" FontSize="{StaticResource AgyFontSizeCaption}" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource AgyAccentLight}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ==================== VIEW 1: SCHNELLSTART- & BUTTON-LISTE ==================== -->
                        <Grid x:Name="PnlCustomPromptListView" Grid.Row="1" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Top Actions Bar -->
                            <Border Grid.Row="0" Padding="14,12,14,8" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Schnellstart-Buttons:" FontSize="{StaticResource AgyFontSizeBody}" FontWeight="SemiBold" Foreground="{StaticResource AgyTextStrong}" />
                                        <TextBlock Text="Klicke auf einen Button, um ihn sofort auszuführen." FontSize="{StaticResource AgyFontSizeMicro}" Foreground="{StaticResource AgyTextMuted}" />
                                    </StackPanel>

                                    <Button Style="{StaticResource AgyPrimaryButtonStyle}" x:Name="BtnAddCustomPrompt" Grid.Column="1" Click="BtnAddCustomPrompt_Click" Padding="10,6" ToolTipService.ToolTip="Neuen Custom Button anlegen">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="+" FontSize="{StaticResource AgyFontSizeBodyLarge}" FontWeight="Bold" Foreground="White" />
                                            <TextBlock Text="Neuer Button" FontSize="{StaticResource AgyFontSizeCaption}" FontWeight="SemiBold" Foreground="White" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Scrollable Cards List -->
                            <ScrollViewer Grid.Row="1" Padding="14,4,14,20" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="10">
                                    <StackPanel x:Name="PnlCustomPromptCardsList" Spacing="8">
                                        <!-- Dynamically generated prompt cards -->
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ==================== VIEW 2: INLINE-EDITOR ==================== -->
                        <Grid x:Name="PnlCustomPromptFormView" Grid.Row="1" Visibility="Collapsed">
                            <ScrollViewer Padding="14,14,14,24" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="12">
                                    <!-- Back to list button -->
                                    <Button Style="{StaticResource AgyGhostButtonStyle}" Click="BtnBackToPromptList_Click" Padding="8,4" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="← Zurück zur Liste" FontSize="{StaticResource AgyFontSizeCaption}" Foreground="{StaticResource AgyTextSecondary}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Button Name -->
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Button-Name:" FontSize="{StaticResource AgyFontSizeBody}" FontWeight="SemiBold" Foreground="{StaticResource AgyTextSecondary}" />
                                        <TextBox x:Name="TxtCustomPromptName"
                                                 PlaceholderText="z. B. Reflexion oder Test-Suite"
                                                 MaxLength="30"
                                                 FontSize="{StaticResource AgyFontSizeBody}"
                                                 CornerRadius="{StaticResource AgyRadiusMd}"
                                                 Background="{StaticResource AgyMainBg}"
                                                 Foreground="{StaticResource AgyTextPrimary}"
                                                 BorderBrush="{StaticResource AgyBorderDefault}"
                                                 Padding="8,6" />
                                    </StackPanel>

                                    <!-- Farbwahl Palette -->
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Farbe &amp; Icon-Akzent:" FontSize="{StaticResource AgyFontSizeBody}" FontWeight="SemiBold" Foreground="{StaticResource AgyTextSecondary}" />
                                        <StackPanel x:Name="PnlColorPalette" Orientation="Horizontal" Spacing="8">
                                            <!-- 8 Farbkreise dynamically created -->
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Prompt Text -->
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Prompt-Inhalt:" FontSize="{StaticResource AgyFontSizeBody}" FontWeight="SemiBold" Foreground="{StaticResource AgyTextSecondary}" />
                                        <TextBox x:Name="TxtCustomPromptInput"
                                                 PlaceholderText="z. B. [Prüfe deine letzte Arbeit adaptiv nach Risiko und Aufwand... (go).]"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="160"
                                                 FontSize="{StaticResource AgyFontSizeBody}"
                                                 FontFamily="Consolas"
                                                 CornerRadius="{StaticResource AgyRadiusMd}"
                                                 Background="{StaticResource AgyMainBg}"
                                                 Foreground="{StaticResource AgyTextPrimary}"
                                                 BorderBrush="{StaticResource AgyBorderDefault}"
                                                 Padding="8,8"
                                                 KeyDown="TxtCustomPromptInput_KeyDown" />
                                    </StackPanel>

                                    <!-- Action Buttons: Speichern & Abbrechen -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button AllowFocusOnInteraction="False" Click="BtnBackToPromptList_Click" Grid.Column="0" Content="Abbrechen" HorizontalAlignment="Stretch" Margin="0,0,4,0" CornerRadius="{StaticResource AgyRadiusMd}" MinHeight="36" FontSize="{StaticResource AgyFontSizeBody}" Background="Transparent" BorderBrush="{StaticResource AgyBorderDefault}" Foreground="{StaticResource AgyTextSecondary}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ToolTipService.ToolTip="Abbrechen und zurück zur Liste (Esc)" />
                                        <Button AllowFocusOnInteraction="False" Click="BtnSaveCustomPromptForm_Click" Grid.Column="1" Content="Speichern" HorizontalAlignment="Stretch" Margin="4,0,0,0" CornerRadius="{StaticResource AgyRadiusMd}" MinHeight="36" FontSize="{StaticResource AgyFontSizeBody}" FontWeight="SemiBold" Background="{StaticResource AgyAccent}" Foreground="White" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ToolTipService.ToolTip="Prompt speichern (Strg+Enter)" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                    </Grid>

                    <!-- Bottom Bar (Settings & Controls Footer) -->
                    <Border Grid.Row="3" Background="{StaticResource AgySurfaceBg}" BorderBrush="{StaticResource AgyBorderFaint}" BorderThickness="0,1,0,0" Padding="8,6">
                        <StackPanel Spacing="6">
                            <!-- Row 1: Tools & Stiller Host Toggle -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Tool Buttons: Settings, System Check, Hygiene, Updates, Models, Shortcuts -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                    <Button Style="{StaticResource AgyGhostButtonStyle}" Click="BtnConfigSettings_Click" Tag="Konfiguration (/config)" Width="32" Height="32" BorderThickness="0" ToolTipService.ToolTip="Konfiguration (/config in Terminal senden)">
                                        <ImageIcon Source="ms-appx:///Assets/Icons/settings.svg" Width="16" Height="16" UseLayoutRounding="True" />
                                    </Button>
                                    <Button Style="{StaticResource AgyGhostButtonStyle}" x:Name="BtnSystemCheckSidebar" Click="BtnSystemCheck_Click" Tag="System-Voraussetzungen" Width="32" Height="32" BorderThickness="0" ToolTipService.ToolTip="System-Voraussetzungen &amp; Live-Versionen prüfen">
                                        <ImageIcon Source="ms-appx:///Assets/Icons/monitor-check.svg" Width="16" Height="16" UseLayoutRounding="True" />
                                    </Button>
                                    <Button Style="{StaticResource AgyGhostButtonStyle}" x:Name="BtnProjectCleanupSidebar" Click="BtnProjectCleanup_Click" RightTapped="BtnProjectCleanup_RightTapped" Tag="Projekt-Hygiene &amp; Audit" Width="32" Height="32" BorderThickness="0" ToolTipService.ToolTip="Projekt-Hygiene &amp; Audit (Klick: Alle Projekte | Rechtsklick: Nur aktuelles Projekt | Shift+Klick: Sofort absenden)">
                                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path x:Name="IconProjectCleanupSidebar" Data="M10,22 c2.761,0 5,-1.79 5,-4 c-4.42,0 -4.08,-5 -8.5,-5 a1,1 0 1,0 0,9 Z a3,3 0 0,1 -3,-3 M12.5,11.5 L22,2 M6.98,13.02 l2.665,-2.664 a1.21,1.21 0 0,1 1.71,0 l2.29,2.288 a1.21,1.21 0 0,1 0,1.712 l-2.088,2.087" Stroke="{StaticResource AgyTextSecondary}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" />
                                            </Viewbox>
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource AgyGhostButtonStyle}" x:Name="BtnCheckGlobalUpdates" Click="BtnCheckGlobalUpdates_Click" Tag="Auf Updates prüfen" Width="32" Height="32" BorderThickness="0" ToolTipService.ToolTip="Auf Updates prüfen (Wissens-Update-Prompt in Chat-Eingabe einfügen)">
                                        <ImageIcon Source="ms-appx:///Assets/Icons/radio-tower.svg" Width="16" Height="16" UseLayoutRounding="True" />
                                    </Button>
                                    <Button Style="{StaticResource AgyGhostButtonStyle}" x:Name="BtnUpdateModelSpecs" Click="BtnUpdateModelSpecs_Click" Tag="KI-Modelle &amp; Skala updaten" Width="32" Height="32" BorderThickness="0" ToolTipService.ToolTip="KI-Modelle &amp; Token-Skala synchronisieren ('agy models' auslesen, Grenzwerte im Web prüfen &amp; Skala aktualisieren)">
                                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="M4 4h16v16H4z M9 9h6v6H9z M9 1v3 M15 1v3 M9 20v3 M15 20v3 M20 9h3 M20 14h3 M1 9h3 M1 14h3" Stroke="{StaticResource AgyTextSecondary}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" />
                                            </Viewbox>
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource AgyGhostButtonStyle}" Click="BtnTerminalShortcuts_Click" Tag="Terminal Shortcuts" Width="32" Height="32" BorderThickness="0" ToolTipService.ToolTip="Terminal Tastenkombinationen (Shortcuts) anzeigen">
                                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z M6 8h.01 M10 8h.01 M14 8h.01 M18 8h.01 M6 12h.01 M10 12h.01 M14 12h.01 M18 12h.01 M7 16h10" Stroke="{StaticResource AgyTextSecondary}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" />
                                            </Viewbox>
                                        </Grid>
                                    </Button>
                                </StackPanel>

                                <!-- Console Host Toggle -->
                                <ToggleButton x:Name="TglConsoleHost" Grid.Column="1" Click="TglConsoleHost_Click" Tag="Stiller Konsolenhost" AllowFocusOnInteraction="False" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="{StaticResource AgyRadiusMd}" IsChecked="True" ToolTipService.ToolTip="Stiller Konsolenhost aktiv (Verhindert Terminal-Aufblitzen bei AGY-Tools)">
                                    <ToggleButton.Resources>
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#3B82F6" Opacity="0.2" />
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#3B82F6" Opacity="0.3" />
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#3B82F6" Opacity="0.1" />
                                        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#3B82F6" Opacity="0.4" />
                                    </ToggleButton.Resources>
                                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M4 17l6-6-6-6 M12 19h8" Stroke="{StaticResource AgyTextSecondary}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" />
                                        </Viewbox>
                                    </Grid>
                                </ToggleButton>
                            </Grid>

                            <!-- Row 2: Font Size, Telemetry & Hard Reset -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Font Size Control -->
                                <Border Grid.Column="0" Height="28" CornerRadius="{StaticResource AgyRadiusMd}" BorderThickness="1" BorderBrush="{StaticResource AgyBorderFaint}" Background="{StaticResource AgyAccentSubtle}" Padding="2,0">
                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Button Style="{StaticResource AgyGhostButtonStyle}" Click="BtnFontDecrease_Click" Width="20" Height="20" CornerRadius="{StaticResource AgyRadiusSm}" BorderThickness="0" ToolTipService.ToolTip="Schrift verkleinern">
                                            <ImageIcon Source="ms-appx:///Assets/Icons/minus.svg" Width="10" Height="10" UseLayoutRounding="True" />
                                        </Button>
                                        <TextBlock x:Name="TxtFontSize" Text="16" FontSize="{StaticResource AgyFontSizeSubtitle}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AgyTextSecondary}" VerticalAlignment="Center" MinWidth="18" Padding="2,0" TextAlignment="Center" />
                                        <Button Style="{StaticResource AgyGhostButtonStyle}" Click="BtnFontIncrease_Click" Width="20" Height="20" CornerRadius="{StaticResource AgyRadiusSm}" BorderThickness="0" ToolTipService.ToolTip="Schrift vergrößern">
                                            <ImageIcon Source="ms-appx:///Assets/Icons/plus.svg" Width="10" Height="10" UseLayoutRounding="True" />
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Telemetry & Bug Capture Button + Hard Reset -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Style="{StaticResource AgyGhostButtonStyle}" x:Name="BtnCaptureTelemetry" Click="BtnCaptureTelemetry_Click" Width="28" Height="28" BorderThickness="0" ToolTipService.ToolTip="Diagnose-Logs &amp; Telemetrie in Zwischenablage kopieren">
                                        <ImageIcon x:Name="IcoTelemetry" Source="ms-appx:///Assets/Icons/bug.svg" Width="15" Height="15" UseLayoutRounding="True" />
                                    </Button>

                                    
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Draggable Sidebar Resize Handle (links innerhalb der Sidebar-Spalte; Doppelklick = Standardbreite) -->
            <local:ResizeHandle x:Name="SplitterSidebar"
                                  Grid.Column="1"
                                  Width="8"
                                  HorizontalAlignment="Left"
                                  Background="Transparent"
                                  ToolTipService.ToolTip="Ziehen: Breite ändern · Doppelklick: zurücksetzen"
                                  PointerPressed="SplitterSidebar_PointerPressed"
                                  PointerMoved="SplitterSidebar_PointerMoved"
                                  PointerReleased="SplitterSidebar_PointerReleased"
                                  PointerCaptureLost="SplitterSidebar_PointerCaptureLost"
                                  PointerEntered="SplitterSidebar_PointerEntered"
                                  PointerExited="SplitterSidebar_PointerExited"
                                  DoubleTapped="SplitterSidebar_DoubleTapped">
                <Border x:Name="BdrSplitterSidebarIndicator"
                        Width="2"
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        CornerRadius="1" />
            </local:ResizeHandle>

            <!-- ==================== MAIN CONTENT AREA ==================== -->
            <Grid Grid.Column="0" Background="{StaticResource AgyTerminalBg}">
                <Grid.RowDefinitions>
                    <!-- Row 0: Workspace TabBar (Terminal, Open Files) -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 1: Workspace & Co-Browser Split Area -->
                    <RowDefinition Height="*" />
                    <!-- Row 2: Chat Input Bar -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 3: Footer Info -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- TAB BAR (Oberhalb Hauptbereich) -->
                <Border Grid.Row="0" Height="36" Background="{StaticResource AgySurfaceBg}" BorderBrush="{StaticResource AgyBorderFaint}" BorderThickness="0,0,0,1" Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Dynamic Open Tabs Container -->
                        <ScrollViewer x:Name="SvWorkspaceTabs"
                                      Grid.Column="0"
                                      HorizontalScrollBarVisibility="Hidden"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollBarVisibility="Disabled"
                                      VerticalScrollMode="Disabled"
                                      PointerWheelChanged="SvWorkspaceTabs_PointerWheelChanged"
                                      ViewChanged="SvWorkspaceTabs_ViewChanged"
                                      SizeChanged="SvWorkspaceTabs_SizeChanged">
                            <StackPanel x:Name="PnlWorkspaceTabs" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                <!-- Dynamic tabs generated in C# -->
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Tab Overflow & Action Controls -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="6,0,0,0">
                            <!-- Scroll Left -->
                            <Button x:Name="BtnScrollTabsLeft"
                                    Style="{StaticResource AgyBorderlessButtonStyle}"
                                    Width="26"
                                    Height="26"
                                    CornerRadius="{StaticResource AgyRadiusSm}"
                                    VerticalAlignment="Center"
                                    Click="BtnScrollTabsLeft_Click"
                                    Visibility="Collapsed"
                                    ToolTipService.ToolTip="Tabs nach links scrollen">
                                <FontIcon Glyph="&#xE76B;" FontSize="11" Foreground="{StaticResource AgyTextSecondary}" />
                            </Button>

                            <!-- Scroll Right -->
                            <Button x:Name="BtnScrollTabsRight"
                                    Style="{StaticResource AgyBorderlessButtonStyle}"
                                    Width="26"
                                    Height="26"
                                    CornerRadius="{StaticResource AgyRadiusSm}"
                                    VerticalAlignment="Center"
                                    Click="BtnScrollTabsRight_Click"
                                    Visibility="Collapsed"
                                    ToolTipService.ToolTip="Tabs nach rechts scrollen">
                                <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="{StaticResource AgyTextSecondary}" />
                            </Button>

                            <!-- All Open Tabs Dropdown Menu -->
                            <Button x:Name="BtnOpenTabsList"
                                    Style="{StaticResource AgyBorderlessButtonStyle}"
                                    Width="26"
                                    Height="26"
                                    CornerRadius="{StaticResource AgyRadiusSm}"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Alle geöffneten Tabs anzeigen (Liste)">
                                <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{StaticResource AgyTextSecondary}" />
                                <Button.Flyout>
                                    <MenuFlyout x:Name="FlyoutWorkspaceTabsList" Placement="BottomEdgeAlignedRight" Opening="FlyoutWorkspaceTabsList_Opening">
                                        <!-- Dynamisch befüllt -->
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>

                            <!-- Tab Actions Menu (Kompaktes Dropdown-Menü für maximalen Platz in der Tab-Leiste) -->
                            <Button Style="{StaticResource AgyBorderlessButtonStyle}"
                                    x:Name="BtnTabActionsMenu"
                                    Tag="Tab-Aktionen"
                                    Width="28"
                                    Height="28"
                                    CornerRadius="{StaticResource AgyRadiusSm}"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Tab- &amp; Terminal-Aktionen (Weitere Optionen)">
                                <ImageIcon Source="ms-appx:///Assets/Icons/more-horizontal.svg" Width="14" Height="14" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem Text="Letzte KI-Antwort im Editor öffnen" Click="BtnOpenLastResponse_Click">
                                            <MenuFlyoutItem.Icon>
                                                <ImageIcon Source="ms-appx:///Assets/Icons/file-text.svg" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Gesamten Chatverlauf als Markdown öffnen" Click="BtnOpenFullChat_Click">
                                            <MenuFlyoutItem.Icon>
                                                <ImageIcon Source="ms-appx:///Assets/Icons/message-square.svg" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Letzte KI-Antwort kopieren" Click="BtnCopyLastResponse_Click">
                                            <MenuFlyoutItem.Icon>
                                                <ImageIcon Source="ms-appx:///Assets/Icons/copy.svg" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Terminal-Inhalt kopieren" Click="BtnCopyTerminal_Click">
                                            <MenuFlyoutItem.Icon>
                                                <ImageIcon Source="ms-appx:///Assets/Icons/copy.svg" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Aktiven Tab neu laden" Click="BtnRefreshTerminal_Click">
                                            <MenuFlyoutItem.Icon>
                                                <ImageIcon Source="ms-appx:///Assets/Icons/refresh-cw.svg" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Andere Tabs schließen" Click="BtnCloseOtherTabs_Click">
                                            <MenuFlyoutItem.Icon>
                                                <ImageIcon Source="ms-appx:///Assets/Icons/x.svg" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- SPLIT CONTENT AREA: WORKSPACE (LINKS BEI X=0) + SPLITTER + CO-BROWSER (RECHTS) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Workspace Column (Links bei X=0 zur vollständigen Airspace-Isolation) -->
                        <ColumnDefinition x:Name="ColMainWorkspace" Width="*" />
                        <!-- Splitter Column -->
                        <ColumnDefinition x:Name="ColCoBrowserSplitter" Width="Auto" />
                        <!-- Co-Browser Column (Rechts) -->
                        <ColumnDefinition x:Name="ColCoBrowser" Width="0" />
                    </Grid.ColumnDefinitions>

                    <!-- Workspace Area (Terminal Container OR File Editor OR Side-by-Side Split) (Links bei X=0) -->
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <!-- Terminal Column -->
                            <ColumnDefinition x:Name="ColTerminal" Width="*" />
                            <!-- Splitter Column for Editor Split -->
                            <ColumnDefinition x:Name="ColEditorSplitter" Width="Auto" />
                            <!-- Split Editor Column -->
                            <ColumnDefinition x:Name="ColEditor" Width="0" />
                        </Grid.ColumnDefinitions>

                        <!-- NATIVE WINDOWS CONSOLE HWND HOST CONTAINER (Dynamic Multi-Terminal Container) -->
                        <Grid x:Name="TerminalContainer" Grid.Column="0" Background="{StaticResource AgyTerminalBg}" Margin="16,100,16,0" Padding="0" Visibility="Visible">
                            <!-- Dynamic EasyTerminalControl instances managed in C# -->
                        </Grid>

                        <!-- SPLITTER DIVIDER FOR EDITOR SPLIT -->
                        <local:ResizeHandle x:Name="SplitterEditor" 
                                              Grid.Column="1" 
                                              Width="6" 
                                              Background="Transparent" 
                                              Visibility="Collapsed"
                                              ToolTipService.ToolTip="Ziehen: Breite anpassen"
                                              PointerPressed="SplitterEditor_PointerPressed"
                                              PointerMoved="SplitterEditor_PointerMoved"
                                              PointerReleased="SplitterEditor_PointerReleased">
                            <Border Width="1" Background="{StaticResource AgyBorderDefault}" HorizontalAlignment="Center" VerticalAlignment="Stretch" />
                        </local:ResizeHandle>

                        <!-- FILE EDITOR CONTAINER USERCONTROL -->
                        <views:EditorView x:Name="UcEditor" Grid.Column="2" Visibility="Collapsed" Margin="0,0,16,0" />

                        <!-- ==================== VERTICAL AUDIO PEAK LEVEL METER (16px Hitbox, Scoped to Workspace) ==================== -->
                        <Grid Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Right" Width="16" Margin="0" Canvas.ZIndex="50"
                              Background="Transparent"
                              x:Name="TokenPeakMeterContainer" x:FieldModifier="public"
                              SizeChanged="TokenPeakMeterContainer_SizeChanged"
                              PointerEntered="TokenPeakMeterContainer_PointerEntered"
                              PointerExited="TokenPeakMeterContainer_PointerExited"
                              Tapped="TokenPeakMeterContainer_Tapped">
                            <FlyoutBase.AttachedFlyout>
                                <Flyout x:Name="FlyoutTokenDetails" x:FieldModifier="public" Placement="LeftEdgeAlignedBottom" ShouldConstrainToRootBounds="False">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="Background" Value="{StaticResource AgyCardBg}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AgyBorderDefault}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="CornerRadius" Value="{StaticResource AgyRadiusLg}" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="MinWidth" Value="330" />
                                            <Setter Property="MaxWidth" Value="380" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <Border Padding="16,14">
                                        <StackPanel Spacing="10">
                                            <!-- Header: Model Info & Status Badge -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="⚡" FontSize="{StaticResource AgyFontSizeBodyLarge}" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TxtTokenFlyoutModelName" Text="Modell-Kontext" FontWeight="SemiBold" FontSize="{StaticResource AgyFontSizeBodyLarge}" Foreground="{StaticResource AgyTextPrimary}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Border Grid.Column="1" x:Name="BdrTokenFlyoutStatusBadge" Background="#1A10B981" CornerRadius="{StaticResource AgyRadiusSm}" Padding="8,3" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtTokenFlyoutStatusLevel" Text="Optimal" FontSize="{StaticResource AgyFontSizeMicro}" FontWeight="SemiBold" Foreground="{StaticResource AgyStatusSuccess}" />
                                                </Border>
                                            </Grid>

                                            <!-- Token Meter Numbers & Progress Bar -->
                                            <StackPanel Spacing="5">
                                                <Grid>
                                                    <TextBlock x:Name="TxtTokenFlyoutUsageNumbers" Text="0 / 1.048.576 Tokens" FontSize="{StaticResource AgyFontSizeCaption}" Foreground="{StaticResource AgyTextSecondary}" FontFamily="Consolas" />
                                                    <TextBlock x:Name="TxtTokenFlyoutRatio" Text="0.0%" HorizontalAlignment="Right" FontSize="{StaticResource AgyFontSizeCaption}" FontWeight="SemiBold" Foreground="{StaticResource AgyTextPrimary}" FontFamily="Consolas" />
                                                </Grid>
                                                <ProgressBar x:Name="PrgTokenFlyoutRatio" Height="5" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource AgyStatusSuccess}" Background="{StaticResource AgySurfaceBg}" CornerRadius="2" />
                                            </StackPanel>

                                            <!-- Divider -->
                                            <Border Height="1" Background="{StaticResource AgyBorderFaint}" Margin="0,2" />

                                            <!-- Detailed Category Breakdown -->
                                            <TextBlock x:Name="TxtTokenFlyoutDetails" FontSize="{StaticResource AgyFontSizeCaption}" LineHeight="19" Foreground="{StaticResource AgyTextSecondary}" FontFamily="Consolas" TextWrapping="Wrap" />

                                            <!-- Action Toolbar -->
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{StaticResource AgySubtleAccentButtonStyle}" x:Name="BtnTokenFlyoutContext" Click="BtnTokenFlyoutContext_Click" Margin="0,0,4,0" HorizontalAlignment="Stretch" ToolTipService.ToolTip="/context im Terminal ausführen">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                        <FontIcon Glyph="&#xE9D9;" FontSize="11" />
                                                        <TextBlock Text="/context" FontSize="{StaticResource AgyFontSizeCaption}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="1" Style="{StaticResource AgySubtleAccentButtonStyle}" x:Name="BtnTokenFlyoutCompact" Click="BtnTokenFlyoutCompact_Click" Margin="4,0,4,0" HorizontalAlignment="Stretch" ToolTipService.ToolTip="/compact im Terminal ausführen">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                        <FontIcon Glyph="&#xE749;" FontSize="11" />
                                                        <TextBlock Text="/compact" FontSize="{StaticResource AgyFontSizeCaption}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="2" Style="{StaticResource AgyGhostButtonStyle}" x:Name="BtnTokenFlyoutRefresh" Click="BtnTokenFlyoutRefresh_Click" Margin="4,0,0,0" Width="30" Height="30" Padding="0" ToolTipService.ToolTip="Token-Zähler neu einlesen">
                                                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </FlyoutBase.AttachedFlyout>

                            <!-- Background Track (Subtle Dark Divider) -->
                            <Border x:Name="TokenPeakMeterTrackBorder" x:FieldModifier="public"
                                    Width="4" HorizontalAlignment="Center"
                                    Background="{StaticResource AgyCardBg}" Opacity="0.35" CornerRadius="2" />

                            <!-- Active Vertical VU Bar (Grows from Bottom to Top of Terminal Window) -->
                            <Grid VerticalAlignment="Bottom" Height="0" Width="4" HorizontalAlignment="Center"
                                  x:Name="TokenPeakMeterActiveBar" x:FieldModifier="public" Opacity="0.55">
                                <Border x:Name="TokenPeakMeterBarBorder" x:FieldModifier="public"
                                        Background="#10B981" CornerRadius="2" />
                            </Grid>

                            <!-- Peak Hold Horizontal Tick Indicator -->
                            <Border x:Name="TokenPeakHoldMarker" x:FieldModifier="public"
                                    Height="3" Width="6"
                                    Background="{StaticResource AgyStatusInfo}"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Center"
                                    Opacity="0" />
                        </Grid>
                    </Grid>

                    <!-- Draggable Splitter Divider -->
                    <local:ResizeHandle x:Name="SplitterCoBrowser" 
                            Grid.Column="1" 
                            Width="6" 
                            Background="Transparent" 
                            Visibility="Collapsed"
                            PointerPressed="SplitterCoBrowser_PointerPressed"
                            PointerMoved="SplitterCoBrowser_PointerMoved"
                            PointerReleased="SplitterCoBrowser_PointerReleased">
                        <Border Width="1" Background="{StaticResource AgyBorderDefault}" HorizontalAlignment="Center" VerticalAlignment="Stretch" />
                    </local:ResizeHandle>

                    <!-- Co-Browser UserControl (Rechts) -->
                    <views:CoBrowserView x:Name="UcCoBrowser" Grid.Column="2" Visibility="Collapsed" />
                </Grid>

                <!-- CHAT INPUT AREA USERCONTROL (Volle Breite unterhalb Workspace und Co-Browser) -->
                <views:PromptEditorView x:Name="UcPromptEditor" Grid.Row="2" />

                <!-- FOOTER (Community Edition Version) -->
                <Grid Grid.Row="3" Background="{StaticResource AgyInputBg}" Padding="16,2,16,2">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Background="Transparent">
                        <TextBlock Text="AGY CLI Dashboard &#x2022; Community Edition" FontSize="{StaticResource AgyFontSizeMicro}" Foreground="{StaticResource AgyTextSubtle}" VerticalAlignment="Center" FontFamily="Consolas" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>


        <!-- Hidden Background Terminal Container for AutoSync /resume -->
        <Grid x:Name="HiddenSyncTerminalContainer" Width="1" Height="1" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
    </Grid>
</Window>








