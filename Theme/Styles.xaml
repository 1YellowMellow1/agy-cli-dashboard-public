<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ============================================================
        AGY BUTTON-STILE (benoetigt Theme/Palette.xaml)
        ============================================================
        Alle Stile basieren auf DefaultButtonStyle (behalten also Template, Hover-/Pressed-Zustaende
        und die globalen Button*-Theme-Overrides aus App.xaml). Lokale Attribute am Button
        (Width, Height, Padding, CornerRadius ...) ueberschreiben die Style-Werte weiterhin.

        Varianten:
          AgyGhostButtonStyle         transparent mit feinem Rahmen (Standard fuer Icon-Buttons)
          AgySubtleAccentButtonStyle  dezent blau hinterlegt (hervorgehobene Aktion)
          AgySurfaceButtonStyle       Flaechenfarbe mit feinem Rahmen (sekundaere Aktion)
          AgyPrimaryButtonStyle       Akzent-gefuellt (primaere Aktion)
          AgyDangerButtonStyle        rot gefuellt (destruktive Aktion)
          AgyTabButtonStyle           Tab-Button ohne native Hover-Visualstates
    -->

    <Style x:Key="AgyGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="AllowFocusOnInteraction" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource AgyBorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AgyRadiusMd}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Randloser Ghost-Button fuer minimalistische Toolbar- und Icon-Actions -->
    <Style x:Key="AgyBorderlessButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="AllowFocusOnInteraction" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource AgyRadiusSm}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="AgySubtleAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="AllowFocusOnInteraction" Value="False" />
        <Setter Property="Background" Value="{StaticResource AgyAccentSubtle}" />
        <Setter Property="BorderBrush" Value="{StaticResource AgyBorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AgyRadiusMd}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="AgySurfaceButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="AllowFocusOnInteraction" Value="False" />
        <Setter Property="Background" Value="{StaticResource AgySurfaceBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource AgyBorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AgyRadiusSm}" />
    </Style>

    <Style x:Key="AgyPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="AllowFocusOnInteraction" Value="False" />
        <Setter Property="Background" Value="{StaticResource AgyAccent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource AgyRadiusMd}" />
    </Style>

    <Style x:Key="AgyDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="AllowFocusOnInteraction" Value="False" />
        <Setter Property="Background" Value="{StaticResource AgyStatusDanger}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource AgyRadiusMd}" />
    </Style>

    <!-- Custom Tab Button Style without native WinUI 3 hover visual state overrides -->
    <Style x:Key="AgyTabButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AgyTextMuted}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource AgyRadiusMd}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter x:Name="ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Padding="{TemplateBinding Padding}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Einheitlicher Kategorie-Header-Stil fuer alle Sidebar-Tabs -->
    <Style x:Key="AgySidebarSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource AgyFontSizeCaption}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource AgyTextSubtle}" />
        <Setter Property="CharacterSpacing" Value="10" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
