<UserControl
    x:Class="AgyCliDashboard.Views.ChatSidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgyCliDashboard.Views"
    xmlns:root="using:AgyCliDashboard"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Action / Confirmation Bars & Section Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,6">
            <TextBlock Style="{StaticResource AgySidebarSectionHeaderStyle}" Text="CHATS &amp; SESSIONS" Margin="0,0,0,4" />

            <!-- MULTI SELECT BATCH DELETE BAR -->
            <Border x:Name="PnlMultiSelectBar" Visibility="Collapsed" Background="{StaticResource AgyCardBg}" BorderBrush="{StaticResource AgyStatusDanger}" BorderThickness="1" CornerRadius="{StaticResource AgyRadiusLg}" Padding="8,6" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Style="{StaticResource AgySurfaceButtonStyle}" Click="BtnSelectAllChats_Click" Height="26" Padding="6,0" ToolTipService.ToolTip="Alle angezeigten Chats markieren">
                            <TextBlock Text="Alle" FontSize="{StaticResource AgyFontSizeBodyLarge}" FontWeight="SemiBold" Foreground="{StaticResource AgyTextSecondary}" />
                        </Button>
                        <Button Style="{StaticResource AgySurfaceButtonStyle}" Click="BtnDeselectAllChats_Click" Height="26" Padding="6,0" ToolTipService.ToolTip="Markierung aufheben">
                            <TextBlock Text="Keine" FontSize="{StaticResource AgyFontSizeBodyLarge}" FontWeight="SemiBold" Foreground="{StaticResource AgyTextMuted}" />
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Style="{StaticResource AgyDangerButtonStyle}" x:Name="BtnDeleteSelectedChats" Click="BtnDeleteSelectedChats_Click" Height="26" Padding="8,0" CornerRadius="{StaticResource AgyRadiusSm}" ToolTipService.ToolTip="Ausgewählte Chats löschen">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ImageIcon Source="ms-appx:///Assets/Icons/trash-2.svg" Width="11" Height="11" />
                                <TextBlock x:Name="TxtDeleteSelectedCount" Text="Löschen (0)" FontSize="{StaticResource AgyFontSizeBodyLarge}" FontWeight="Bold" Foreground="{StaticResource AgyTextPrimary}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource AgyGhostButtonStyle}" Click="BtnCancelMultiSelect_Click" Width="26" Height="26" BorderThickness="0" CornerRadius="{StaticResource AgyRadiusSm}" ToolTipService.ToolTip="Auswahlmodus beenden">
                            <!-- Lucide x -->
                            <ImageIcon Source="ms-appx:///Assets/Icons/x.svg" Width="12" Height="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- SINGLE CHAT DELETE CONFIRMATION -->
            <Border x:Name="PnlSingleDeleteConfirm" Visibility="Collapsed" Background="{StaticResource AgyCardBg}" BorderBrush="{StaticResource AgyStatusDanger}" BorderThickness="1" CornerRadius="{StaticResource AgyRadiusLg}" Padding="12" Margin="0,0,0,8">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ImageIcon Source="ms-appx:///Assets/Icons/trash-2.svg" Width="16" Height="16" />
                        <TextBlock Text="Chat unwiderruflich löschen?" FontSize="{StaticResource AgyFontSizeTitle}" FontWeight="Bold" Foreground="{StaticResource AgyTextPrimary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="TxtSingleDeleteConfirmTitle" Text="'Mein Chat Titel'" FontSize="{StaticResource AgyFontSizeSubtitle}" Foreground="{StaticResource AgyTextSecondary}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Click="BtnCancelSingleDelete_Click" Content="Abbrechen" HorizontalAlignment="Stretch" Background="{StaticResource AgySurfaceBg}" BorderBrush="{StaticResource AgyBorderDefault}" Foreground="{StaticResource AgyTextSecondary}" CornerRadius="{StaticResource AgyRadiusMd}" FontSize="{StaticResource AgyFontSizeSubtitle}" />
                        <Button Grid.Column="1" Click="BtnConfirmSingleDelete_Click" Content="Löschen" HorizontalAlignment="Stretch" Background="{StaticResource AgyStatusDanger}" Foreground="White" FontWeight="Bold" BorderThickness="0" CornerRadius="{StaticResource AgyRadiusMd}" FontSize="{StaticResource AgyFontSizeSubtitle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- MULTI CHAT DELETE CONFIRMATION -->
            <Border x:Name="PnlMultiDeleteConfirm" Visibility="Collapsed" Background="{StaticResource AgyCardBg}" BorderBrush="{StaticResource AgyStatusDanger}" BorderThickness="1" CornerRadius="{StaticResource AgyRadiusLg}" Padding="12" Margin="0,0,0,8">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ImageIcon Source="ms-appx:///Assets/Icons/trash-2.svg" Width="16" Height="16" />
                        <TextBlock Text="Ausgewählte Chats löschen?" FontSize="{StaticResource AgyFontSizeTitle}" FontWeight="Bold" Foreground="{StaticResource AgyTextPrimary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="TxtMultiDeleteConfirmDetail" Text="Möchtest du die ausgewählten Chats wirklich dauerhaft löschen?" FontSize="{StaticResource AgyFontSizeSubtitle}" Foreground="{StaticResource AgyTextSecondary}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Click="BtnCancelMultiDeleteConfirm_Click" Content="Abbrechen" HorizontalAlignment="Stretch" Background="{StaticResource AgySurfaceBg}" BorderBrush="{StaticResource AgyBorderDefault}" Foreground="{StaticResource AgyTextSecondary}" CornerRadius="{StaticResource AgyRadiusMd}" FontSize="{StaticResource AgyFontSizeSubtitle}" />
                        <Button Grid.Column="1" Click="BtnConfirmMultiDelete_Click" Content="Alle löschen" HorizontalAlignment="Stretch" Background="{StaticResource AgyStatusDanger}" Foreground="White" FontWeight="Bold" BorderThickness="0" CornerRadius="{StaticResource AgyRadiusMd}" FontSize="{StaticResource AgyFontSizeSubtitle}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- CHATS TAB VIRTUALIZED LISTVIEW -->
        <ListView x:Name="ListChats"
                  Grid.Row="1"
                  ItemsSource="{x:Bind Chats, Mode=OneWay}"
                  Visibility="Visible"
                  SelectionMode="None"
                  Background="Transparent"
                  BorderThickness="0"
                  Margin="-12,0,-12,0"
                  Padding="8,0">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Vertical" ItemsUpdatingScrollMode="KeepScrollOffset" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="12,2" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border Margin="{TemplateBinding Margin}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="root:AgyChatSession">
                    <Grid Height="50" PointerEntered="ChatItem_PointerEntered" PointerExited="ChatItem_PointerExited" Tapped="ChatItem_Tapped" Margin="0,2" Background="Transparent">
                        <!-- Hover Background -->
                        <Border Background="{StaticResource AgyHoverOverlay}" CornerRadius="{StaticResource AgyRadiusMd}" Visibility="{x:Bind HoverIndicatorVisibility, Mode=OneWay}" />

                        <!-- Content -->
                        <Grid Padding="6,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Selection CheckBox -->
                            <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Checked="ChatCheckBox_CheckedChanged" Unchecked="ChatCheckBox_CheckedChanged" Tapped="ChatCheckBox_Tapped" Visibility="{x:Bind SelectionCheckBoxVisibility, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="0" />
                            
                            <Grid Grid.Column="1" VerticalAlignment="Center" RowSpacing="3">
                                 <Grid.RowDefinitions>
                                     <RowDefinition Height="Auto" />
                                     <RowDefinition Height="Auto" />
                                 </Grid.RowDefinitions>

                                 <!-- Title Row -->
                                 <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                     <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                                         <Path Data="M12 2C10.5 2 9 5 7.5 9C6 13 4 19 3 22H8C8.5 20 9.5 17 10.5 14C11 13 11.5 12.5 12 12.5C12.5 12.5 13 13 13.5 14C14.5 17 15.5 20 16 22H21C20 19 18 13 16.5 9C15 5 13.5 2 12 2Z"
                                               Fill="{StaticResource AgyLogoGradientBrush}" Stretch="Uniform" />
                                     </Viewbox>
                                     <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="{StaticResource AgyFontSizeBodyLarge}" FontWeight="SemiBold" Foreground="{StaticResource AgyTextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}" />
                                 </StackPanel>

                                 <!-- Footer Row: Action Pair (Pin + Trash) + Date/Steps -->
                                 <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="-3,0,0,0">
                                     <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Margin="0">
                                         <Button Click="BtnTogglePin_Click" Tapped="BtnTogglePin_Tapped" Tag="{x:Bind Id}" Width="20" Height="20" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Chat oben anheften / lösen" AllowFocusOnInteraction="False">
                                             <Viewbox Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                 <Path Data="M12 17v5 M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"
                                                       Stroke="{x:Bind PinStrokeColor, Mode=OneWay}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" />
                                             </Viewbox>
                                         </Button>
                                         <Button Click="BtnDeleteSingleChat_Click" Tapped="BtnDeleteSingleChat_Tapped" Tag="{x:Bind Id}" Width="20" Height="20" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Chat löschen" AllowFocusOnInteraction="False" VerticalAlignment="Center">
                                             <Viewbox Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                 <Path Data="M10 11v6 M14 11v6 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6 M3 6h18 M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
                                                       Stroke="{StaticResource AgyTextMuted}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" />
                                             </Viewbox>
                                         </Button>
                                     </StackPanel>
                                     <TextBlock Text="{x:Bind FormattedDate, Mode=OneWay}" FontSize="{StaticResource AgyFontSizeCaption}" Foreground="{StaticResource AgyTextMuted}" VerticalAlignment="Center" ToolTipService.ToolTip="Letzte Aktivität und Interaktions-Schritte" />
                                 </StackPanel>
                             </Grid>
                            
                            <Rectangle Grid.Column="2" Width="1" Fill="{StaticResource AgyBorderDefault}" VerticalAlignment="Stretch" Margin="4,2" Visibility="{x:Bind HoverIndicatorVisibility, Mode=OneWay}" />

                            <Button Grid.Column="3" Click="BtnOpenWithClawCode_Click" Tapped="BtnOpenWithClawCode_Tapped" Tag="{x:Bind Id}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Chat in der alternativen ClawCode-Konsole öffnen" AllowFocusOnInteraction="False" Visibility="{x:Bind HoverIndicatorVisibility, Mode=OneWay}" Width="42">
                                <TextBlock Text="🦞" FontSize="{StaticResource AgyFontSizeHeadline}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty State Panel -->
        <Border x:Name="PnlEmptyState" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,30,16,16">
            <StackPanel Spacing="10" HorizontalAlignment="Center">
                <ImageIcon Source="ms-appx:///Assets/Icons/message-square.svg" Width="36" Height="36" HorizontalAlignment="Center" Opacity="0.35" />
                <TextBlock Text="Noch keine Chats vorhanden" FontSize="{StaticResource AgyFontSizeBodyLarge}" FontWeight="SemiBold" Foreground="{StaticResource AgyTextSecondary}" HorizontalAlignment="Center" />
                <TextBlock Text="Starte deine erste Unterhaltung über das Chat-Eingabefeld oder erstelle einen neuen Chat." FontSize="{StaticResource AgyFontSizeCaption}" Foreground="{StaticResource AgyTextMuted}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="260" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
