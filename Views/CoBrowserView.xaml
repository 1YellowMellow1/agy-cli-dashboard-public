<UserControl
    x:Class="AgyCliDashboard.Views.CoBrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    KeyDown="UserControl_KeyDown"
    SizeChanged="UserControl_SizeChanged">

    <Grid Background="{StaticResource AgyMainBg}">
        <Grid.RowDefinitions>
            <!-- Toolbar / Navigation Bar -->
            <RowDefinition Height="Auto" />
            <!-- Browser Host Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Navigation & Control Toolbar (Maximized URL Capsule & Action Menu) -->
        <Border Grid.Row="0" Background="{StaticResource AgySurfaceBg}" BorderBrush="{StaticResource AgyBorderFaint}" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- URL Address Capsule (spans full width) -->
                    <ColumnDefinition Width="*" />
                    <!-- Right Compact Actions: Status Dot, Three-Dots Menu (···), Close Button -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Floating URL Capsule -->
                <Border Grid.Column="0" 
                        Margin="0,0,8,0" 
                        Height="28"
                        Background="{StaticResource AgyCardBg}" 
                        BorderBrush="{StaticResource AgyBorderFaint}" 
                        BorderThickness="1" 
                        CornerRadius="14" 
                        Padding="10,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Lock / Security Icon -->
                        <Viewbox Grid.Column="0" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Path Data="M19 11H5a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2zm-8-7a4 4 0 0 1 4 4v3H9V8a4 4 0 0 1 4-4z" Stroke="{StaticResource AgyTextSubtle}" StrokeThickness="1.5" Stretch="Uniform" />
                        </Viewbox>

                        <!-- Address Input Field (optisch exakt vertikal zentriert) -->
                        <TextBox x:Name="TxtUrl" 
                                 Grid.Column="1"
                                 KeyDown="TxtUrl_KeyDown" 
                                 PlaceholderText="URL eingeben (z. B. https://google.com)..." 
                                 Height="26" 
                                 MinHeight="0"
                                 Margin="0"
                                 Padding="0,6,0,0" 
                                 FontSize="{StaticResource AgyFontSizeCaption}" 
                                 FontFamily="Consolas" 
                                 Background="Transparent" 
                                 Foreground="{StaticResource AgyTextPrimary}" 
                                 BorderThickness="0" 
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                            </TextBox.Resources>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- Right Actions: Status Dot, Three-Dots Menu (···), Close Button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <!-- Status Dot (Textlos mit Tooltip & Hover) -->
                    <Border x:Name="BdrStatusBadge" 
                            Tapped="BdrStatusBadge_Tapped" 
                            RightTapped="BdrStatusBadge_RightTapped" 
                            PointerEntered="BdrStatusBadge_PointerEntered"
                            PointerExited="BdrStatusBadge_PointerExited"
                            Width="28" Height="28" 
                            CornerRadius="14" 
                            BorderThickness="1" 
                            BorderBrush="{StaticResource AgyBorderFaint}" 
                            Background="{StaticResource AgySurfaceSubtle}" 
                            Padding="0" 
                            VerticalAlignment="Center" 
                            ToolTipService.ToolTip="Status: Bereit (Klick: Hinweis-Sprechblase · Rechtsklick: Reflexions-Prompt)">
                        <Ellipse x:Name="DotStatus" Width="8" Height="8" Fill="{StaticResource AgyStatusSuccess}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Drei-Punkte-Menü (···) mit allen gebündelten Aktionen -->
                    <Button Style="{StaticResource AgyBorderlessButtonStyle}" 
                            x:Name="BtnMoreActions" 
                            Width="28" Height="28" 
                            CornerRadius="{StaticResource AgyRadiusSm}" 
                            ToolTipService.ToolTip="Menü, Navigation &amp; Zoom">
                        <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M12 13a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm7 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zM5 13a1 1 0 1 0 0-2 1 1 0 0 0 0 2z" Fill="{StaticResource AgyTextSecondary}" Stretch="Uniform" />
                        </Viewbox>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <!-- Navigation Section -->
                                <MenuFlyoutItem x:Name="MenuItemBack" Text="Zurück" Click="BtnBack_Click" ToolTipService.ToolTip="Alt + Pfeil links">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuItemForward" Text="Vorwärts" Click="BtnForward_Click" ToolTipService.ToolTip="Alt + Pfeil rechts">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE72A;" FontSize="14" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Neu laden" Click="BtnReload_Click" ToolTipService.ToolTip="F5">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Startseite" Click="BtnHome_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE80F;" FontSize="14" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutSeparator />

                                <!-- Zoom Section -->
                                <ToggleMenuFlyoutItem x:Name="MenuItemAutoFitZoom" Text="Auto-Fit (Breite anpassen)" Click="MenuItemAutoFitZoom_Click" IsChecked="True" ToolTipService.ToolTip="Passt überbreite Seiten automatisch an die Fensterbreite an">
                                    <ToggleMenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE740;" FontSize="14" />
                                    </ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <MenuFlyoutItem Text="Zoom vergrößern (+10%)" Click="BtnZoomIn_Click" ToolTipService.ToolTip="Strg + +">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Zoom verkleinern (-10%)" Click="BtnZoomOut_Click" ToolTipService.ToolTip="Strg + -">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE738;" FontSize="14" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuItemZoomReset" Text="Zoom zurücksetzen (Auto-Fit)" Click="BtnZoomReset_Click" ToolTipService.ToolTip="Strg + 0">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSubItem x:Name="MenuSubZoomLevels" Text="Feste Zoom-Stufe">
                                    <MenuFlyoutSubItem.Icon>
                                        <FontIcon Glyph="&#xE71E;" FontSize="14" />
                                    </MenuFlyoutSubItem.Icon>
                                    <MenuFlyoutItem Text="150%" Click="MenuZoomLevel_Click" Tag="1.5" />
                                    <MenuFlyoutItem Text="125%" Click="MenuZoomLevel_Click" Tag="1.25" />
                                    <MenuFlyoutItem Text="100% (Original)" Click="MenuZoomLevel_Click" Tag="1.0" />
                                    <MenuFlyoutItem Text="90%" Click="MenuZoomLevel_Click" Tag="0.9" />
                                    <MenuFlyoutItem Text="85% (Standard)" Click="MenuZoomLevel_Click" Tag="0.85" />
                                    <MenuFlyoutItem Text="75%" Click="MenuZoomLevel_Click" Tag="0.75" />
                                    <MenuFlyoutItem Text="67%" Click="MenuZoomLevel_Click" Tag="0.67" />
                                    <MenuFlyoutItem Text="60%" Click="MenuZoomLevel_Click" Tag="0.6" />
                                    <MenuFlyoutItem Text="50%" Click="MenuZoomLevel_Click" Tag="0.5" />
                                </MenuFlyoutSubItem>

                                <MenuFlyoutSeparator />

                                <!-- Associated Chat -->
                                <MenuFlyoutItem x:Name="MenuItemAssociatedChat" Text="Chat: Kein Chat verbunden" Click="MenuItemAssociatedChat_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8BD;" FontSize="14" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutSeparator />

                                <!-- Pop-out Window -->
                                <MenuFlyoutItem x:Name="MenuItemPopOut" Text="Ausdocken (Separates Fenster)" Click="BtnPopOut_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <!-- Close Co-Browser -->
                                <MenuFlyoutItem Text="Co-Browser schließen" Click="BtnClose_Click" ToolTipService.ToolTip="Strg+Shift+B">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Close Split Button (✕) -->
                    <Button Style="{StaticResource AgyBorderlessButtonStyle}" 
                            x:Name="BtnClose" 
                            Click="BtnClose_Click" 
                            Width="28" Height="28" 
                            CornerRadius="{StaticResource AgyRadiusSm}" 
                            ToolTipService.ToolTip="Co-Browser schließen (Strg+Shift+B)">
                        <ImageIcon Source="ms-appx:///Assets/Icons/x.svg" Width="11" Height="11" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Browser Container with Loading Bar & Placeholder -->
        <Grid Grid.Row="1">
            <!-- Loading Indicator Bar -->
            <ProgressBar x:Name="ProgressBarLoading" 
                         Height="2" 
                         VerticalAlignment="Top" 
                         Canvas.ZIndex="10" 
                         IsIndeterminate="True" 
                         Visibility="Collapsed" 
                         Foreground="{StaticResource AgyAccent}" />

            <!-- WebView2 Control -->
            <WebView2 x:Name="BrowserControl" 
                      HorizontalAlignment="Stretch" 
                      VerticalAlignment="Stretch" />

            <!-- Antigravity Speech Bubble Overlay (Handoff / Benutzer-Aktion) -->
            <Grid x:Name="PnlSpeechBubble" 
                  Canvas.ZIndex="50" 
                  HorizontalAlignment="Right" 
                  VerticalAlignment="Top" 
                  Margin="16,4,16,0" 
                  MinWidth="280" 
                  MaxWidth="440" 
                  Visibility="Collapsed">
                <Grid.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="-16" />
                    </TransitionCollection>
                </Grid.ChildrenTransitions>

                <StackPanel Orientation="Vertical" HorizontalAlignment="Right">
                    <!-- Speech Bubble Pointer (Pfeil nach oben zur Status-Pille) -->
                    <Path Data="M 0 8 L 8 0 L 16 8" 
                          Fill="{StaticResource AgyCardBg}" 
                          Stroke="{StaticResource AgyBorderDefault}" 
                          StrokeThickness="1" 
                          HorizontalAlignment="Right" 
                          Margin="0,0,180,0" />

                    <!-- Speech Bubble Main Card -->
                    <Border Margin="0,-1,0,0" 
                            Background="{StaticResource AgyCardBg}" 
                            BorderBrush="{StaticResource AgyBorderDefault}" 
                            BorderThickness="1" 
                            CornerRadius="16" 
                            Padding="16,14">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header: Antigravity Avatar, Name, Status Badge, Close -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Avatar -->
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15" Background="{StaticResource AgyAccentSubtle}" BorderBrush="{StaticResource AgyAccent}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="✦" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AgyAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Speaker Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="Antigravity" FontWeight="Bold" FontSize="{StaticResource AgyFontSizeBody}" Foreground="{StaticResource AgyTextPrimary}" />
                                        <Border Background="{StaticResource AgyStatusWarning}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="Aktion nötig" FontSize="{StaticResource AgyFontSizeMicro}" FontWeight="Bold" Foreground="#1e1e1e" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="KI-Assistent bittet um Unterstützung" FontSize="{StaticResource AgyFontSizeMicro}" Foreground="{StaticResource AgyTextSubtle}" />
                                </StackPanel>

                                <!-- Close Button -->
                                <Button Grid.Column="2" Style="{StaticResource AgyBorderlessButtonStyle}" Click="BtnCloseSpeechBubble_Click" Width="24" Height="24" CornerRadius="12" ToolTipService.ToolTip="Sprechblase minimieren">
                                    <ImageIcon Source="ms-appx:///Assets/Icons/x.svg" Width="10" Height="10" />
                                </Button>
                            </Grid>

                            <!-- Speech Message Body -->
                            <Border Grid.Row="1" Background="{StaticResource AgySurfaceSubtle}" BorderBrush="{StaticResource AgyBorderFaint}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                <TextBlock x:Name="TxtSpeechBubbleMessage" 
                                           Text="Nachricht von Antigravity..." 
                                           FontSize="{StaticResource AgyFontSizeBody}" 
                                           Foreground="{StaticResource AgyTextPrimary}" 
                                           TextWrapping="Wrap" 
                                           IsTextSelectionEnabled="True" 
                                           LineHeight="20" />
                            </Border>

                            <!-- Action Buttons Footer -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Klicke auf Erledigt, wenn du fertig bist." FontSize="{StaticResource AgyFontSizeMicro}" Foreground="{StaticResource AgyTextSubtle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Style="{StaticResource AgySurfaceButtonStyle}" Click="BtnCloseSpeechBubble_Click" Content="Später" Height="30" Padding="12,0" FontSize="{StaticResource AgyFontSizeCaption}" />
                                    <Button Style="{StaticResource AgyPrimaryButtonStyle}" x:Name="BtnSpeechBubbleDone" Click="BtnSpeechBubbleDone_Click" Height="30" Padding="14,0" FontSize="{StaticResource AgyFontSizeCaption}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="✓" FontWeight="Bold" />
                                            <TextBlock Text="Erledigt / Bereit" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Initial Placeholder / Empty State (vor Initialisierung) -->
            <Grid x:Name="PnlPlaceholder" Background="{StaticResource AgyMainBg}" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <ImageIcon Source="ms-appx:///Assets/Icons/globe.svg" Width="42" Height="42" HorizontalAlignment="Center" Opacity="0.5" />
                    <TextBlock x:Name="TxtPlaceholderTitle" Text="KI-Co-Browser initialisiert..." FontSize="{StaticResource AgyFontSizeBodyLarge}" FontWeight="SemiBold" Foreground="{StaticResource AgyTextSecondary}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="TxtPlaceholderSubtitle" Text="Wird mit Remote-Debugging-Port verbunden..." FontSize="{StaticResource AgyFontSizeCaption}" Foreground="{StaticResource AgyTextSubtle}" HorizontalAlignment="Center" />
                    <ProgressRing x:Name="RingPlaceholder" IsActive="True" Width="24" Height="24" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
