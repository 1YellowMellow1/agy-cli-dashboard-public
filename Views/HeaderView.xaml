<UserControl
    x:Class="AgyCliDashboard.Views.HeaderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border x:Name="AppHeaderBorder" x:FieldModifier="public" Background="{StaticResource AgyHeaderBg}" BorderBrush="{StaticResource AgyBorderDefault}" BorderThickness="0,0,0,1" Padding="16,0">
        <Grid x:Name="AppTitleBar" x:FieldModifier="public">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left Section: Sidebar Toggle & App Logo/Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Style="{StaticResource AgyGhostButtonStyle}" Click="BtnToggleSidebar_Click" Width="32" Height="32" CornerRadius="{StaticResource AgyRadiusLg}" IsTabStop="False" AllowFocusOnInteraction="False" ToolTipService.ToolTip="Sidebar umschalten">
                    <!-- Lucide panel-left -->
                    <ImageIcon Source="ms-appx:///Assets/Icons/panel-left.svg" Width="18" Height="18" UseLayoutRounding="True" />
                </Button>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ImageIcon Source="ms-appx:///Assets/Icons/antigravity-logo.svg" Width="20" Height="20" UseLayoutRounding="True" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ANTIGRAVITY" FontSize="{StaticResource AgyFontSizeBody}" FontWeight="Bold" Foreground="{StaticResource AgyTextSecondary}" CharacterSpacing="50" />
                        <TextBlock Text="CLI Dashboard" FontSize="{StaticResource AgyFontSizeMicro}" Foreground="{StaticResource AgyTextSubtle}" Margin="0,-2,0,0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Status Badges & Tools (Kompakt-Layout) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="10,0,0,0">
                <!-- Co-Browser Split-Screen Toggle Button (Kompakter Icon-Button) -->
                <Button Style="{StaticResource AgyGhostButtonStyle}" x:Name="BtnCoBrowserToggle" x:FieldModifier="public" Click="BtnCoBrowserToggle_Click" RightTapped="BtnCoBrowserToggle_RightTapped" Height="28" Width="30" CornerRadius="{StaticResource AgyRadiusMd}" Background="{StaticResource AgySurfaceSubtle}" BorderBrush="{StaticResource AgyBorderFaint}" Padding="0" ToolTipService.ToolTip="KI-Co-Browser Split-Screen umschalten (Strg+Shift+B · Rechtsklick: Audit &amp; Reset)">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ImageIcon Source="ms-appx:///Assets/Icons/globe.svg" Width="14" Height="14" UseLayoutRounding="True" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtCoBrowserHeader" x:FieldModifier="public" Text="" Visibility="Collapsed" />
                    </Grid>
                </Button>

                <!-- Connection Status Badge (Eingebettet in KI-Status-Dot, im DOM erhalten) -->
                <Border x:Name="BdrConnectionStatus" x:FieldModifier="public" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="IconConnectionStatus" x:FieldModifier="public" />
                        <TextBlock x:Name="TxtConnectionStatus" x:FieldModifier="public" />
                    </StackPanel>
                </Border>

                <!-- CLI Update Status Button -->
                <Button Style="{StaticResource AgyGhostButtonStyle}" x:Name="BtnCheckUpdate" x:FieldModifier="public" Click="BtnCheckUpdate_Click" RightTapped="BtnCheckUpdate_RightTapped" Tag="CLI Updates Prüfen" Height="28" CornerRadius="{StaticResource AgyRadiusMd}" Background="{StaticResource AgySurfaceSubtle}" BorderBrush="{StaticResource AgyBorderFaint}" Padding="6,0" ToolTipService.ToolTip="Klicke für CLI-Changelog &amp; Release-Notes (Rechtsklick: Version &amp; Updates prüfen)">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Grid VerticalAlignment="Center">
                            <Ellipse x:Name="DotCliStatus" x:FieldModifier="public" Width="7" Height="7" Fill="{StaticResource AgyAccent}" />
                            <ProgressRing x:Name="SpinnerCliStatus" x:FieldModifier="public" Width="9" Height="9" IsActive="False" Visibility="Collapsed" />
                        </Grid>
                        <TextBlock x:Name="TxtCliStatus" x:FieldModifier="public" Text="Aktuell" FontSize="{StaticResource AgyFontSizeCaption}" FontWeight="Medium" Foreground="{StaticResource AgyTextSecondary}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- OpenRouter Balance Badge -->
                <Border x:Name="BdrOpenRouterBalance" x:FieldModifier="public" Height="28" CornerRadius="{StaticResource AgyRadiusMd}" BorderThickness="1" BorderBrush="{StaticResource AgyBorderFaint}" Padding="8,0" Background="{StaticResource AgySurfaceSubtle}" ToolTipService.ToolTip="OpenRouter Guthaben" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="$" FontSize="{StaticResource AgyFontSizeCaption}" FontWeight="Bold" Foreground="{StaticResource AgyStatusSuccess}" VerticalAlignment="Center" Margin="0,0,1,0"/>
                        <TextBlock x:Name="TxtOpenRouterBalance" x:FieldModifier="public" Text="0.00" FontSize="{StaticResource AgyFontSizeCaption}" FontWeight="Medium" Foreground="{StaticResource AgyTextSecondary}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Latest Gemini Model Status Button -->
                <Button Style="{StaticResource AgyGhostButtonStyle}" x:Name="BtnGeminiModelStatus" x:FieldModifier="public" Click="BtnGeminiModelStatus_Click" RightTapped="BtnGeminiModelStatus_RightTapped" Height="28" CornerRadius="{StaticResource AgyRadiusMd}" Background="{StaticResource AgySurfaceSubtle}" BorderBrush="{StaticResource AgyBorderFaint}" Padding="6,0" ToolTipService.ToolTip="Aktuellstes Gemini-Modell wird ermittelt...">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <ImageIcon Source="ms-appx:///Assets/Icons/gemini-sparkle.svg" Width="13" Height="13" UseLayoutRounding="True" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtGeminiModelStatus" x:FieldModifier="public" Text="Gemini..." FontSize="{StaticResource AgyFontSizeCaption}" FontWeight="Medium" Foreground="{StaticResource AgyTextSecondary}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Work Condition & API Load Status Badge (Immer ganz rechts außen) -->
                <Border x:Name="BdrApiLoadStatus" x:FieldModifier="public" Height="28" CornerRadius="{StaticResource AgyRadiusMd}" BorderThickness="1" BorderBrush="{StaticResource AgyBorderFaint}" Padding="6,0" Background="{StaticResource AgySurfaceSubtle}" ToolTipService.ToolTip="KI-Antwortzeit &amp; Server-Erreichbarkeit werden ermittelt...">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Grid VerticalAlignment="Center">
                            <Ellipse x:Name="DotApiLoadStatus" x:FieldModifier="public" Width="7" Height="7" Fill="{StaticResource AgyStatusSuccess}" />
                            <ProgressRing x:Name="SpinnerApiLoadStatus" x:FieldModifier="public" Width="9" Height="9" IsActive="False" Visibility="Collapsed" />
                        </Grid>
                        <TextBlock x:Name="TxtApiLoadStatus" x:FieldModifier="public" Text="Prüfen..." FontSize="{StaticResource AgyFontSizeCaption}" FontWeight="Medium" Foreground="{StaticResource AgyTextSecondary}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Center Section: TitleBar Drag Area & Header System Notification Banner -->
            <Grid Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!-- Dedicated transparent drag area so only this center region acts as the window caption/titlebar -->
                <Border x:Name="TitleBarDragArea" x:FieldModifier="public" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                <Border x:Name="PnlHeaderNotification" x:FieldModifier="public" Visibility="Collapsed" Height="34" Margin="16,0" Background="{StaticResource AgyCardBg}" BorderBrush="{StaticResource AgyBorderDefault}" BorderThickness="1" CornerRadius="{StaticResource AgyRadiusLg}" Padding="12,0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Ellipse x:Name="DotHeaderNotice" x:FieldModifier="public" Grid.Column="0" Width="8" Height="8" Fill="{StaticResource AgyAccent}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="TxtHeaderNoticeTitle" x:FieldModifier="public" Grid.Column="1" Text="Meldung" FontSize="{StaticResource AgyFontSizeBody}" FontWeight="Bold" Foreground="{StaticResource AgyTextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="TxtHeaderNoticeMessage" x:FieldModifier="public" Grid.Column="2" Text="Systemnachricht..." FontSize="{StaticResource AgyFontSizeCaption}" Foreground="{StaticResource AgyTextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

                        <Button Style="{StaticResource AgyGhostButtonStyle}" Grid.Column="3" Click="BtnCloseHeaderNotice_Click" Width="20" Height="20" BorderThickness="0" CornerRadius="10" ToolTipService.ToolTip="Schließen">
                            <ImageIcon Source="ms-appx:///Assets/Icons/x.svg" Width="10" Height="10" Foreground="{StaticResource AgyTextMuted}" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right Section: Window Caption Spacing -->
            <StackPanel x:Name="RightTitleBarArea" x:FieldModifier="public" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,138,0" />
        </Grid>
    </Border>
</UserControl>
