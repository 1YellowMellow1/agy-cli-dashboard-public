<UserControl
    x:Class="AgyCliDashboard.Views.FilesSidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Search Area (Fest oben verankert) -->
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,6">
            <!-- Dynamic Header Container (PROJEKT-DATEIEN + Aktionsbuttons) -->
            <ContentControl x:Name="FilesHeaderContainer" x:FieldModifier="public" HorizontalContentAlignment="Stretch">
                <TextBlock x:Name="TxtFilesHeader" Style="{StaticResource AgySidebarSectionHeaderStyle}" Text="PROJEKT-DATEIEN" Margin="0,0,0,6" />
            </ContentControl>

            <!-- Search Field -->
            <Grid x:Name="PnlFileSearch" x:FieldModifier="public" Visibility="Collapsed">
                <TextBox x:Name="TxtFileSearch" x:FieldModifier="public"
                         PlaceholderText="Dateien durchsuchen... (Esc)"
                         FontSize="{StaticResource AgyFontSizeBody}"
                         Background="{StaticResource AgyMainBg}"
                         Foreground="{StaticResource AgyTextPrimary}"
                         BorderBrush="{StaticResource AgyBorderDefault}"
                         CornerRadius="{StaticResource AgyRadiusMd}"
                         Padding="8,4,28,4" />

                <!-- Clear Button -->
                <Button x:Name="BtnClearFileSearch" x:FieldModifier="public"
                        Width="22" Height="22" Padding="0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,4,0"
                        Background="Transparent" BorderThickness="0"
                        CornerRadius="4" Visibility="Collapsed"
                        ToolTipService.ToolTip="Suche leeren (Esc)">
                    <ImageIcon Source="ms-appx:///Assets/Icons/x.svg" Width="10" Height="10" Opacity="0.7" />
                </Button>
            </Grid>
        </StackPanel>

        <!-- Scrollable Files List / Tree -->
        <ScrollViewer Grid.Row="1" x:Name="FilesPanelScrollViewer" x:FieldModifier="public"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AllowDrop="True" Background="Transparent">
            <StackPanel x:Name="FilesPanel" x:FieldModifier="public" Visibility="Visible" Spacing="4"
                        AllowDrop="True" Background="Transparent">
                <TextBlock x:Name="TxtFilesEmptySelection" Text="Bitte wähle oben ein konkretes Projekt aus, um dessen Dateien anzuzeigen." FontSize="{StaticResource AgyFontSizeBodyLarge}" Foreground="{StaticResource AgyTextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
