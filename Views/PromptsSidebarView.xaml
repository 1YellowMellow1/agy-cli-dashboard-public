<UserControl
    x:Class="AgyCliDashboard.Views.PromptsSidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgyCliDashboard.Views"
    xmlns:root="using:AgyCliDashboard"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Search Area -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,4">
            <!-- Header with Title, Count Badge and Refresh -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource AgySidebarSectionHeaderStyle}" Text="PROMPT-VORLAGEN" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Background="{StaticResource AgyAccentSubtle}" CornerRadius="10" Padding="7,2" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPromptCount" Text="0 Prompts" FontSize="{StaticResource AgyFontSizeMicro}" FontWeight="SemiBold" Foreground="{StaticResource AgyAccent}" />
                    </Border>
                    <Button Style="{StaticResource AgyGhostButtonStyle}" Click="BtnRefresh_Click" Width="26" Height="26" BorderThickness="0" CornerRadius="{StaticResource AgyRadiusSm}" HorizontalAlignment="Right" ToolTipService.ToolTip="Prompts neu laden">
                        <ImageIcon Source="ms-appx:///Assets/Icons/refresh-cw.svg" Width="12" Height="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Active Chat Subtitle -->
            <Border Background="{StaticResource AgyCardBg}" BorderBrush="{StaticResource AgyBorderDefault}" BorderThickness="1" CornerRadius="{StaticResource AgyRadiusMd}" Padding="8,5" Margin="0,6,0,6">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Viewbox Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center">
                        <Path Data="M12 2C10.5 2 9 5 7.5 9C6 13 4 19 3 22H8C8.5 20 9.5 17 10.5 14C11 13 11.5 12.5 12 12.5C12.5 12.5 13 13 13.5 14C14.5 17 15.5 20 16 22H21C20 19 18 13 16.5 9C15 5 13.5 2 12 2Z"
                              Fill="{StaticResource AgyLogoGradientBrush}" Stretch="Uniform" />
                    </Viewbox>
                    <TextBlock Grid.Column="1" x:Name="TxtChatTitle" Text="Aktiver Chat" FontSize="{StaticResource AgyFontSizeCaption}" FontWeight="Medium" Foreground="{StaticResource AgyTextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Search Field -->
            <TextBox x:Name="TxtSearch" PlaceholderText="Prompts durchsuchen..." TextChanged="TxtSearch_TextChanged" FontSize="{StaticResource AgyFontSizeBody}" Background="{StaticResource AgyMainBg}" Foreground="{StaticResource AgyTextPrimary}" BorderBrush="{StaticResource AgyBorderDefault}" CornerRadius="{StaticResource AgyRadiusMd}" Padding="8,4" Margin="0,0,0,6" />
        </StackPanel>

        <!-- Prompts Virtualized ListView -->
        <ListView x:Name="ListPrompts"
                  Grid.Row="1"
                  ItemsSource="{x:Bind DisplayedPrompts, Mode=OneWay}"
                  SelectionMode="None"
                  Background="Transparent"
                  BorderThickness="0"
                  Margin="-12,0,-12,0"
                  Padding="8,0">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Vertical" ItemsUpdatingScrollMode="KeepScrollOffset" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="12,2" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border Margin="{TemplateBinding Margin}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="root:UserPromptItem">
                    <Grid Background="Transparent" Tapped="PromptCard_Tapped" Margin="0,2">
                        <Border Background="{StaticResource AgyCardBg}" BorderBrush="{StaticResource AgyBorderDefault}" BorderThickness="1" CornerRadius="{StaticResource AgyRadiusLg}" Padding="10,8">
                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header: Meta (Index, Time, Attachment) + Actions -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Index + Time + Attachment -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Background="{StaticResource AgyCardBg}" BorderBrush="{StaticResource AgyBorderFaint}" BorderThickness="1" CornerRadius="{StaticResource AgyRadiusSm}" Padding="5,1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DisplayIndex, Mode=OneWay}" FontSize="{StaticResource AgyFontSizeMicro}" FontWeight="Bold" Foreground="{StaticResource AgyAccent}" />
                                        </Border>
                                        <TextBlock Text="{x:Bind FormattedTime, Mode=OneWay}" FontSize="{StaticResource AgyFontSizeCaption}" Foreground="{StaticResource AgyTextMuted}" VerticalAlignment="Center" />
                                        <Border Background="{StaticResource AgyAttachmentBg}" BorderBrush="{StaticResource AgyAttachmentBorder}" BorderThickness="1" CornerRadius="{StaticResource AgyRadiusSm}" Padding="5,1" Visibility="{x:Bind AttachmentVisibility, Mode=OneWay}" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <Viewbox Width="10" Height="10" VerticalAlignment="Center">
                                                    <Path Data="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"
                                                          Stroke="{StaticResource AgyAttachment}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" />
                                                </Viewbox>
                                                <TextBlock Text="{x:Bind AttachmentBadgeText, Mode=OneWay}" FontSize="{StaticResource AgyFontSizeMicro}" Foreground="{StaticResource AgyAttachment}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Right: Action Buttons (Load, Copy, Open In Editor) -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Style="{StaticResource AgyGhostButtonStyle}" Click="BtnLoadPrompt_Click" Tag="{x:Bind}" Width="24" Height="24" BorderThickness="0" CornerRadius="{StaticResource AgyRadiusSm}" ToolTipService.ToolTip="In Chat-Eingabe übernehmen">
                                            <Viewbox Width="12" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Path Data="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z m7.318-19.539-10.94 10.939"
                                                      Stroke="{StaticResource AgyTextMuted}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" />
                                            </Viewbox>
                                        </Button>
                                        <Button Style="{StaticResource AgyGhostButtonStyle}" Click="BtnCopyPrompt_Click" Tag="{x:Bind}" Width="24" Height="24" BorderThickness="0" CornerRadius="{StaticResource AgyRadiusSm}" ToolTipService.ToolTip="Prompt kopieren">
                                            <Viewbox Width="12" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Path Data="M8 8h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V10a2 2 0 0 1 2-2z M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
                                                      Stroke="{StaticResource AgyTextMuted}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" />
                                            </Viewbox>
                                        </Button>
                                        <Button Style="{StaticResource AgyGhostButtonStyle}" Click="BtnOpenEditor_Click" Tag="{x:Bind}" Width="24" Height="24" BorderThickness="0" CornerRadius="{StaticResource AgyRadiusSm}" ToolTipService.ToolTip="Im Editor öffnen">
                                            <Viewbox Width="12" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Path Data="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z M14 2v5a1 1 0 0 0 1 1h5 M10 9H8 M16 13H8 M16 17H8"
                                                      Stroke="{StaticResource AgyTextMuted}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" />
                                            </Viewbox>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Body: Prompt Text -->
                                <TextBlock Grid.Row="1" Text="{x:Bind CleanText, Mode=OneWay}" FontSize="{StaticResource AgyFontSizeBody}" Foreground="{StaticResource AgyTextStrong}" TextWrapping="Wrap" MaxLines="6" TextTrimming="CharacterEllipsis" LineHeight="19" />

                                <!-- Assistant Summary ("Einfach gesagt") -->
                                <Border Grid.Row="2"
                                        Visibility="{x:Bind AssistantSummaryVisibility, Mode=OneWay}"
                                        Background="{StaticResource AgyMainBg}"
                                        BorderBrush="{StaticResource AgyBorderDefault}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource AgyRadiusMd}"
                                        Padding="8,6"
                                        Margin="0,2,0,0">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Glühbirnen Icon -->
                                        <TextBlock Grid.Column="0" Text="💡" FontSize="{StaticResource AgyFontSizeMicro}" VerticalAlignment="Top" Margin="0,1,0,0" />

                                        <!-- Fazit Text -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind AssistantSummary, Mode=OneWay}"
                                                   FontSize="{StaticResource AgyFontSizeCaption}"
                                                   Foreground="{StaticResource AgyTextSecondary}"
                                                   TextWrapping="Wrap"
                                                   MaxLines="4"
                                                   TextTrimming="CharacterEllipsis"
                                                   LineHeight="16.5"
                                                   VerticalAlignment="Center" />

                                        <!-- Fazit Kopieren Button -->
                                        <Button Style="{StaticResource AgyGhostButtonStyle}" Grid.Column="2"
                                                Click="BtnCopySummary_Click"
                                                Tag="{x:Bind}"
                                                Width="22"
                                                Height="22"
                                                BorderThickness="0"
                                                CornerRadius="{StaticResource AgyRadiusSm}"
                                                VerticalAlignment="Top"
                                                ToolTipService.ToolTip="Fazit kopieren">
                                            <Viewbox Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.7">
                                                <Path Data="M8 8h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V10a2 2 0 0 1 2-2z M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
                                                      Stroke="{StaticResource AgyTextMuted}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" />
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty State Panel -->
        <Border x:Name="PnlEmptyState" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,20,16,16">
            <StackPanel Spacing="10" HorizontalAlignment="Center">
                <ImageIcon Source="ms-appx:///Assets/Icons/message-square.svg" Width="36" Height="36" HorizontalAlignment="Center" Opacity="0.35" />
                <TextBlock Text="Keine Prompts vorhanden" FontSize="{StaticResource AgyFontSizeBodyLarge}" FontWeight="SemiBold" Foreground="{StaticResource AgyTextSecondary}" HorizontalAlignment="Center" />
                <TextBlock Text="Sobald du in diesem Chat eine Anweisung oder Frage sendest, wird sie hier für schnellen Zugriff und Wiederverwendung aufgelistet." FontSize="{StaticResource AgyFontSizeCaption}" Foreground="{StaticResource AgyTextMuted}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="260" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
